---
const matchaImg = "https://scontent-ams2-1.cdninstagram.com/v/t51.82787-15/794032623_17948492067266823_7578226426693012433_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=107&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0xJUFMuYmVzdF9pbWFnZV91cmxnZW4uQzMifQ%3D%3D&_nc_ohc=NYjctEAvy7cQ7kNvwFHmiSP&_nc_oc=Adph5_RVWf2icuScJwmhAxHO8P_RB8oZUWFhxo62FNyTEbrzne6WhCP-EQgxmMBZNo4&_nc_zt=23&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=cO0pZhQ1iJyLHDhTQ7H9Fw&_nc_ss=7ba8c&oh=00_AQNZ0AR79KsE0exUGsrTSfuBfJpq0kzO5sgxGTwTZIa6AA&oe=6AC1E3F9";
const coldBrewImg = "https://scontent-ams2-1.cdninstagram.com/v/t15.5256-10/780949353_1596279635189869_1153598757660377946_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=104&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0xJUFMuYmVzdF9pbWFnZV91cmxnZW4uQzMifQ%3D%3D&_nc_ohc=siUSfyJphccQ7kNvwGXGNh3&_nc_oc=Adp5ClswIvrBuk9UMFF2r4wynoSF4eYDZSTdD_YMF--XlB9UJktW_sGhTUrsOYx9e-4&_nc_zt=23&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=cO0pZhQ1iJyLHDhTQ7H9Fw&_nc_ss=7ba8c&oh=00_AQMAFgIL7451-Jw8cT4NeJMKx_lYUvv1mzkKJx0-ZQRwJQ&oe=6AC1E8E3";
---

<section class="relative w-full bg-butter pt-32 pb-20 lg:pt-40 lg:pb-32 overflow-hidden flex items-center min-h-[90vh]">
  <!-- Decorative Checker Cluster -->
  <div class="absolute top-24 right-10 w-24 h-24 hidden md:grid grid-cols-3 grid-rows-3 gap-1 animate-float-slow opacity-80 z-10">
    <div class="bg-pop2 rounded-sm"></div><div></div><div class="bg-pop2 rounded-sm"></div>
    <div></div><div class="bg-pop2 rounded-sm"></div><div></div>
    <div class="bg-pop2 rounded-sm"></div><div></div><div class="bg-pop2 rounded-sm"></div>
  </div>

  <div class="max-w-7xl mx-auto px-6 lg:px-12 w-full relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Text Content -->
      <div class="lg:col-span-6 flex flex-col items-start z-20">
        <h1 class="text-6xl md:text-7xl lg:text-[5.5rem] leading-[0.9] text-anchor font-display uppercase mb-6">
          <span class="block overflow-hidden"><span class="block animate-[popIn_0.8s_ease-out_forwards]">Refresh.</span></span>
          <span class="block overflow-hidden"><span class="block animate-[popIn_0.8s_ease-out_0.2s_forwards] opacity-0">Without</span></span>
          <span class="block overflow-hidden"><span class="block text-butter-strong animate-[popIn_0.8s_ease-out_0.4s_forwards] opacity-0">The Guilt.</span></span>
        </h1>
        
        <p class="text-lg md:text-xl font-body text-anchor/80 max-w-md mb-8 leading-relaxed">
          Baghdad’s first diet cafe. We bring you the perfect balance between pleasure and health — every sip designed to invigorate your body and soul.
        </p>

        <div class="flex flex-wrap items-center gap-4">
          <a href="#menu" class="inline-flex items-center gap-3 bg-butter-strong text-base px-8 py-4 rounded-full font-label font-bold uppercase tracking-widest text-sm shadow-hard-dark hover:shadow-hard-pink hover:-translate-y-1 transition-all duration-300">
            Explore Menu
            <span class="w-6 h-6 rounded-full bg-base/20 flex items-center justify-center">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </span>
          </a>
          <a href="https://instagram.com/refresh.baghdad" target="_blank" rel="noopener" class="font-label font-bold uppercase tracking-widest text-sm text-anchor hover:text-pop1 inline-flex items-center gap-2 group">
            Follow @refresh.baghdad
            <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
          </a>
        </div>
      </div>

      <!-- Hero Images (Cutouts / Rounded Masks) -->
      <div class="lg:col-span-6 relative h-[400px] lg:h-[600px] w-full mt-12 lg:mt-0 flex justify-center lg:justify-end">
        <!-- Organic Blob Background -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[80%] h-[80%] bg-butter-strong/20 rounded-blob animate-float-slow z-0"></div>
        
        <!-- Main Product 1 -->
        <div class="absolute top-10 right-10 lg:right-20 w-64 h-80 lg:w-80 lg:h-[26rem] rounded-[2rem] overflow-hidden border-4 border-anchor shadow-hard-pink transform rotate-3 z-10 hover:scale-105 transition-transform duration-500 bg-base">
          <img src={matchaImg} alt="Refresh Iced Matcha" class="w-full h-full object-cover" fetchpriority="high" />
        </div>

        <!-- Main Product 2 (Overlapping) -->
        <div class="absolute bottom-10 left-0 lg:left-10 w-56 h-72 lg:w-72 lg:h-[22rem] rounded-[2rem] overflow-hidden border-4 border-base shadow-hard-dark transform -rotate-6 z-20 hover:scale-105 hover:-translate-y-2 transition-transform duration-500 bg-base">
          <img src={coldBrewImg} alt="Refresh Cold Brew Coffee" class="w-full h-full object-cover" fetchpriority="high" />
        </div>

        <!-- Scattered Props / Stickers -->
        <div class="absolute top-0 right-0 bg-pop2 text-base font-display px-4 py-1 rounded-full transform rotate-12 z-30 shadow-sm border-2 border-anchor">ZERO SUGAR!</div>
        <div class="absolute bottom-32 right-4 lg:right-16 w-12 h-12 bg-star rounded-full flex items-center justify-center border-2 border-anchor z-30 animate-float-delay shadow-sm">
          <svg class="w-6 h-6 text-anchor" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
        </div>
      </div>

    </div>

    <!-- Stats Trio -->
    <div class="mt-20 lg:mt-32 flex flex-wrap items-center justify-start gap-8 lg:gap-16 border-t-2 border-anchor/10 pt-8">
      <div class="flex flex-col">
        <div class="font-display text-4xl md:text-5xl text-anchor">5.0</div>
        <div class="font-label text-xs font-bold tracking-widest uppercase mt-1">Google Rating</div>
      </div>
      <div class="w-px h-12 bg-anchor/20 hidden sm:block"></div>
      <div class="flex flex-col">
        <div class="font-display text-4xl md:text-5xl text-anchor">3.5K+</div>
        <div class="font-label text-xs font-bold tracking-widest uppercase mt-1">Happy Followers</div>
      </div>
      <div class="w-px h-12 bg-anchor/20 hidden sm:block"></div>
      <div class="flex flex-col">
        <div class="font-display text-4xl md:text-5xl text-anchor">100%</div>
        <div class="font-label text-xs font-bold tracking-widest uppercase mt-1">Guilt Free</div>
      </div>
    </div>
  </div>
</section>

<!-- Marquee Ribbon 1 -->
<div class="relative z-20 -mt-6">
  <div class="bg-pop1 text-anchor">
    <!-- Using the reusable marquee component implicitly by mimicking styles or building here -->
    <div class="relative w-[110%] -left-[5%] py-3 bg-pop1 text-anchor transform -rotate-2 shadow-md overflow-hidden flex z-20 border-y-2 border-anchor/90">
      <div class="flex whitespace-nowrap animate-marquee hover:[animation-duration:40s]">
        {Array(10).fill(0).map(() => (
          <div class="flex items-center">
            <span class="font-display text-2xl md:text-4xl tracking-wider px-4">ICED MATCHA</span>
            <span class="text-xl md:text-3xl px-4">★</span>
            <span class="font-display text-2xl md:text-4xl tracking-wider px-4">DIET LATTE</span>
            <span class="text-xl md:text-3xl px-4">★</span>
            <span class="font-display text-2xl md:text-4xl tracking-wider px-4">DATES SHAKE</span>
            <span class="text-xl md:text-3xl px-4">★</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  // Reduced motion check
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (prefersReducedMotion) {
    document.querySelectorAll('.animate-marquee').forEach(el => {
      el.classList.remove('animate-marquee');
    });
  }
</script>