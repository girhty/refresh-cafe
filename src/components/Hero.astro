---
import Checker from './Checker.astro';
const matcha = "https://scontent-ams2-1.cdninstagram.com/v/t51.82787-15/794032623_17948492067266823_7578226426693012433_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=107&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0xJUFMuYmVzdF9pbWFnZV91cmxnZW4uQzMifQ%3D%3D&_nc_ohc=NYjctEAvy7cQ7kNvwFHmiSP&_nc_oc=Adph5_RVWf2icuScJwmhAxHO8P_RB8oZUWFhxo62FNyTEbrzne6WhCP-EQgxmMBZNo4&_nc_zt=23&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=cO0pZhQ1iJyLHDhTQ7H9Fw&_nc_ss=7ba8c&oh=00_AQNZ0AR79KsE0exUGsrTSfuBfJpq0kzO5sgxGTwTZIa6AA&oe=6AC1E3F9";
const milkshake = "https://scontent-ams2-1.cdninstagram.com/v/t51.82787-15/779145745_17946355131266823_6141674129459981372_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=105&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0FST1VTRUxfSVRFTS5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=ZCuU1PJApxgQ7kNvwER0Rna&_nc_oc=AdrMjokD5-9uOyDrezyV0GHSK0I8cT2KHL-hJPKOoiu3Raqa6aSXuijd5D9o71n3MsM&_nc_zt=23&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=cO0pZhQ1iJyLHDhTQ7H9Fw&_nc_ss=7ba8c&oh=00_AQOEJxRfbfvpkJTM8TPNKFYqjff2Qld_qrU6S8fEcTIBzw&oe=6AC1F0DE";
---
<section id="top" class="relative bg-butter overflow-hidden pt-32 md:pt-40 pb-24 md:pb-32">
  <div class="absolute top-24 right-6 md:top-32 md:right-16 opacity-90">
    <Checker colorA="bg-butterStrong" colorB="bg-lavender" cols={5} rows={4} size="w-3 h-3 md:w-4 md:h-4" />
  </div>

  <div class="absolute -top-20 right-0 w-[520px] h-[520px] bg-cream rounded-blob blur-0 opacity-70 -z-0"></div>

  <div class="max-w-[1300px] mx-auto px-5 md:px-8 relative grid md:grid-cols-2 gap-10 items-center">
    <div class="relative z-10">
      <p class="font-mono uppercase text-xs md:text-sm tracking-[0.2em] text-anchorSoft mb-4">Baghdad's First Diet Cafe</p>
      <h1 class="font-display uppercase text-anchor leading-[0.92] text-[13vw] md:text-[5.2vw] tracking-tight">
        Real Flavor.<br/>Zero Guilt.
      </h1>
      <p class="mt-6 max-w-md text-anchorSoft text-base md:text-lg">
        Iced matcha, diet lattes and date-sweet milkshakes — every cup at Refresh is built for balance, not sacrifice.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href="#menu" class="group inline-flex items-center gap-3 bg-butterStrong border-2 border-anchor text-anchor font-mono uppercase text-sm font-bold px-6 py-3 rounded-full shadow-[4px_4px_0_0_#2C1B10] hover:shadow-[6px_6px_0_0_#2C1B10] hover:-translate-y-0.5 transition-all">
          See The Menu
          <span class="w-6 h-6 rounded-full bg-anchor text-cream flex items-center justify-center group-hover:translate-x-1 transition-transform">→</span>
        </a>
        <a href="https://maps.google.com/?q=Refresh+Cafe+Baghdad" target="_blank" rel="noopener" class="font-mono uppercase text-sm font-bold underline underline-offset-4 hover:text-pinkDark inline-flex items-center gap-1">
          Get Directions →
        </a>
      </div>

      <div class="mt-12 flex items-center gap-6 md:gap-10 flex-wrap">
        <div class="flex flex-col">
          <span class="font-display text-4xl md:text-5xl text-anchor" data-count="5" data-decimals="1">0</span>
          <span class="font-mono text-xs uppercase text-anchorSoft mt-1">Google Rating</span>
        </div>
        <div class="w-px h-12 bg-anchor/30"></div>
        <div class="flex flex-col">
          <span class="font-display text-4xl md:text-5xl text-anchor" data-count="5">0</span>
          <span class="font-mono text-xs uppercase text-anchorSoft mt-1">5-Star Reviews</span>
        </div>
        <div class="w-px h-12 bg-anchor/30"></div>
        <div class="flex flex-col">
          <span class="font-display text-4xl md:text-5xl text-anchor" data-count="3.5" data-decimals="1" data-suffix="K+">0</span>
          <span class="font-mono text-xs uppercase text-anchorSoft mt-1">Instagram Family</span>
        </div>
      </div>
    </div>

    <div class="relative h-[380px] md:h-[520px] flex items-center justify-center z-0">
      <div class="absolute w-72 h-72 md:w-96 md:h-96 bg-cream rounded-blob"></div>
      <img src={matcha} alt="Refresh Cafe iced matcha, creamy and smooth" width="360" height="360"
        class="relative rounded-full w-52 h-52 md:w-72 md:h-72 object-cover border-4 border-anchor shadow-[10px_10px_0_0_rgba(44,27,16,0.25)] rotate-[-6deg] animate-float" style="--tilt:-6deg" />
      <img src={milkshake} alt="Refresh Cafe date milkshake" width="220" height="220"
        class="absolute bottom-2 right-4 md:right-10 rounded-full w-32 h-32 md:w-44 md:h-44 object-cover border-4 border-anchor shadow-[8px_8px_0_0_rgba(44,27,16,0.25)] rotate-[8deg] animate-float" style="--tilt:8deg; animation-delay:0.4s" />
      <div class="absolute top-4 left-0 w-6 h-6 rounded-full bg-pink border-2 border-anchor animate-float" style="animation-delay:0.2s"></div>
      <div class="absolute bottom-16 left-4 w-4 h-4 rounded-sm bg-lavender border-2 border-anchor animate-float" style="animation-delay:0.6s"></div>
    </div>
  </div>
</section>