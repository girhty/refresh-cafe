---
<section id="experience" class="relative bg-cream py-24 md:py-32 overflow-hidden">
  <div class="max-w-[1300px] mx-auto px-5 md:px-8 grid md:grid-cols-2 gap-14 items-start">
    <div class="reveal">
      <p class="font-mono uppercase text-xs tracking-[0.2em] text-anchorSoft mb-4">The Space</p>
      <h2 class="font-display uppercase text-anchor text-4xl md:text-6xl leading-[0.92] tracking-tight">
        Come For The Cup.<br/>Stay For The Moment.
      </h2>
      <div class="mt-6">
        <a href="https://maps.google.com/?q=Refresh+Cafe+Baghdad" target="_blank" rel="noopener" class="inline-flex items-center gap-3 bg-butterStrong border-2 border-anchor text-anchor font-mono uppercase text-sm font-bold px-6 py-3 rounded-full shadow-[4px_4px_0_0_#2C1B10] hover:-translate-y-0.5 hover:shadow-[6px_6px_0_0_#2C1B10] transition-all">
          Find Us
          <span class="w-6 h-6 rounded-full bg-anchor text-cream flex items-center justify-center">→</span>
        </a>
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        <span class="chip">Diet-Friendly</span>
        <span class="chip">Quiet Corners</span>
        <span class="chip">Freshly Blended</span>
      </div>
    </div>

    <div class="relative reveal">
      <img id="main-photo" src={images[2].src} alt={images[2].alt} loading="lazy" width="600" height="480"
        class="w-full h-[340px] md:h-[420px] object-cover rounded-[28px] border-2 border-anchor transition-opacity duration-500" />

      <div class="mt-[-40px] ml-[-10px] md:ml-[-30px] flex gap-3 relative z-10 overflow-x-auto pb-2 pr-4">
        {images.map((img, i) => (
          <button
            class={`thumb-btn flex-shrink-0 rounded-2xl border-4 ${i === 2 ? 'border-gold scale-110 -translate-y-1' : 'border-cream'} overflow-hidden transition-all duration-300`}
            data-src={img.src}
            data-alt={img.alt}
            data-index={i}
            aria-label={`Show photo ${i + 1}`}
          >
            <img src={img.src} alt="" loading="lazy" width="80" height="80" class="w-16 h-16 md:w-20 md:h-20 object-cover" />
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .chip { font-family: 'Space Mono', monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; border: 2px solid #2C1B10; padding: 8px 14px; border-radius: 999px; }
</style>

<script>
  const mainPhoto = document.getElementById('main-photo');
  const thumbs = Array.from(document.querySelectorAll('.thumb-btn'));
  thumbs.forEach((btn) => {
    btn.addEventListener('click', () => {
      thumbs.forEach((b) => b.classList.remove('border-gold', 'scale-110', '-translate-y-1'));
      thumbs.forEach((b) => b.classList.add('border-cream'));
      btn.classList.remove('border-cream');
      btn.classList.add('border-gold', 'scale-110', '-translate-y-1');
      if (mainPhoto) {
        mainPhoto.style.opacity = '0';
        setTimeout(() => {
          mainPhoto.setAttribute('src', btn.getAttribute('data-src') || '');
          mainPhoto.setAttribute('alt', btn.getAttribute('data-alt') || '');
          mainPhoto.style.opacity = '1';
        }, 200);
      }
    });
  });
</script>