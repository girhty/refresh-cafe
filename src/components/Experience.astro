---

<section id="experience" class="py-24 lg:py-40 bg-base overflow-hidden relative">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
      
      <!-- Text Column -->
      <div class="reveal-up">
        <div class="font-label text-xs font-bold tracking-[0.2em] text-pop1 mb-6">THE VIBE</div>
        <h2 class="text-5xl lg:text-[5rem] leading-[0.9] text-anchor font-display uppercase mb-8">
          COME FOR THE CUP.<br/>
          <span class="text-butter-strong">STAY FOR THE</span><br/>
          MOMENT.
        </h2>
        
        <a href="https://maps.google.com/?q=شارع+هيل+وزعفران+مجاور+دايت+ستي,+Baghdad" target="_blank" class="inline-flex items-center gap-3 bg-anchor text-base px-8 py-4 rounded-full font-label font-bold uppercase tracking-widest text-sm shadow-hard-pink hover:shadow-hard-dark hover:-translate-y-1 transition-all duration-300 mb-12">
          Get Directions
          <span class="w-6 h-6 rounded-full bg-base/20 flex items-center justify-center">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </span>
        </a>

        <div class="flex flex-wrap gap-3">
          <span class="px-4 py-2 border-2 border-anchor/20 rounded-full font-label text-xs font-bold uppercase tracking-widest text-anchor">Cozy Corners</span>
          <span class="px-4 py-2 border-2 border-anchor/20 rounded-full font-label text-xs font-bold uppercase tracking-widest text-anchor">Guilt-Free</span>
          <span class="px-4 py-2 border-2 border-anchor/20 rounded-full font-label text-xs font-bold uppercase tracking-widest text-anchor">Warm Light</span>
        </div>
      </div>

      <!-- Image Gallery Column -->
      <div class="relative reveal-up" style="transition-delay: 200ms;">
        <!-- Main Image -->
        <div class="rounded-[2rem] overflow-hidden aspect-[4/5] border-4 border-anchor shadow-hard-pink bg-base relative z-10">
          <img src={gallery[0]} alt="People enjoying Refresh Cafe" class="w-full h-full object-cover" loading="lazy" />
        </div>

        <!-- Thumbnails Overlapping -->
        <div class="absolute -bottom-10 -left-6 lg:-left-12 z-20 flex gap-4 p-4 bg-base rounded-3xl border-4 border-anchor shadow-hard-dark transform -rotate-3">
          {gallery.map((img, i) => (
            <button class="w-16 h-16 lg:w-20 lg:h-20 rounded-2xl overflow-hidden border-2 border-anchor transition-transform duration-300 hover:-translate-y-2 focus:outline-none focus:ring-4 focus:ring-pop2">
              <img src={img} alt={`Gallery thumbnail ${i+1}`} class="w-full h-full object-cover" loading="lazy" />
            </button>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>