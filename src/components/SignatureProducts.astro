---
import Checker from './Checker.astro';

const products = [
  {
    name: 'Iced Matcha',
    desc: 'Ceremonial matcha · light milk · no added sugar',
    img: "https://scontent-ams2-1.cdninstagram.com/v/t51.82787-15/794032623_17948492067266823_7578226426693012433_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=107&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0xJUFMuYmVzdF9pbWFnZV91cmxnZW4uQzMifQ%3D%3D&_nc_ohc=NYjctEAvy7cQ7kNvwFHmiSP&_nc_oc=Adph5_RVWf2icuScJwmhAxHO8P_RB8oZUWFhxo62FNyTEbrzne6WhCP-EQgxmMBZNo4&_nc_zt=23&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=cO0pZhQ1iJyLHDhTQ7H9Fw&_nc_ss=7ba8c&oh=00_AQNZ0AR79KsE0exUGsrTSfuBfJpq0kzO5sgxGTwTZIa6AA&oe=6AC1E3F9"
  },
  {
    name: 'Diet Latte',
    desc: 'Same taste you love · calorie-conscious recipe',
    img: "https://scontent-ams2-1.cdninstagram.com/v/t51.82787-15/776718665_17946476757266823_3092288458190742280_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=101&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0xJUFMuYmVzdF9pbWFnZV91cmxnZW4uQzMifQ%3D%3D&_nc_ohc=Z3Cwie8nHwkQ7kNvwEwnhC4&_nc_oc=AdrQtodvlccHUvaeHo7b2bHkP3djMDX5TGMqNPIEaS9OoQkSxtvSUUBXLkte7oWjd2U&_nc_zt=23&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=cO0pZhQ1iJyLHDhTQ7H9Fw&_nc_ss=7ba8c&oh=00_AQPZHPFo9YZI5fw4pcYvmq97sLXDnxDJuow6lCPZGeA_5w&oe=6AC1E3AE"
  },
  {
    name: 'Date Milkshake',
    desc: 'Blended dates · cold milk · naturally sweet',
    img: "https://scontent-ams2-1.cdninstagram.com/v/t51.82787-15/779145745_17946355131266823_6141674129459981372_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=105&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0FST1VTRUxfSVRFTS5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=ZCuU1PJApxgQ7kNvwER0Rna&_nc_oc=AdrMjokD5-9uOyDrezyV0GHSK0I8cT2KHL-hJPKOoiu3Raqa6aSXuijd5D9o71n3MsM&_nc_zt=23&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=cO0pZhQ1iJyLHDhTQ7H9Fw&_nc_ss=7ba8c&oh=00_AQOEJxRfbfvpkJTM8TPNKFYqjff2Qld_qrU6S8fEcTIBzw&oe=6AC1F0DE"
  },
  {
    name: 'Cold Brew',
    desc: 'Slow-extracted · patient flavor · zero rush',
    img: "https://scontent-ams2-1.cdninstagram.com/v/t15.5256-10/780949353_1596279635189869_1153598757660377946_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=104&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0xJUFMuYmVzdF9pbWFnZV91cmxnZW4uQzMifQ%3D%3D&_nc_ohc=siUSfyJphccQ7kNvwGXGNh3&_nc_oc=Adp5ClswIvrBuk9UMFF2r4wynoSF4eYDZSTdD_YMF--XlB9UJktW_sGhTUrsOYx9e-4&_nc_zt=23&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=cO0pZhQ1iJyLHDhTQ7H9Fw&_nc_ss=7ba8c&oh=00_AQMAFgIL7451-Jw8cT4NeJMKx_lYUvv1mzkKJx0-ZQRwJQ&oe=6AC1E8E3"
  }
];
---
<section id="menu" class="relative bg-anchor py-24 md:py-32 overflow-hidden">
  <div class="max-w-[1300px] mx-auto px-5 md:px-8">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-14 reveal">
      <div>
        <p class="font-mono uppercase text-xs tracking-[0.2em] text-cream/70 mb-4">Signature Drinks</p>
        <h2 class="font-display uppercase text-butter text-4xl md:text-6xl leading-[0.92] tracking-tight">
          A Little Different.<br/>Deliciously So.
        </h2>
      </div>
      <div class="flex items-start gap-4 max-w-xs">
        <p class="text-cream/70 text-sm">Every recipe at Refresh is built low-sugar, low-guilt — without cutting the flavor you came for.</p>
        <Checker colorA="bg-lavender" colorB="bg-butterStrong" cols={3} rows={3} size="w-3 h-3" />
      </div>
    </div>

    <div class="relative">
      <div id="carousel-track" class="flex items-end justify-center gap-4 md:gap-6 min-h-[440px] md:min-h-[520px]">
        {products.map((p, i) => (
          <article
            class="carousel-card cursor-pointer select-none transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] rounded-[28px] border-2 border-anchor flex-shrink-0 relative overflow-visible"
            data-index={i}
            data-name={p.name}
          >
            <div class="card-inner rounded-[28px] p-5 md:p-6 flex flex-col h-full">
              <span class="price-chip inline-block self-start bg-pink border-2 border-anchor rounded-full font-mono text-[10px] uppercase font-bold px-3 py-1 -mt-8 mb-3">Ask In Store</span>
              <img src={p.img} alt={p.name} loading="lazy" width="200" height="200" class="product-img rounded-full object-cover border-2 border-anchor mx-auto -mt-2 mb-3" />
              <h3 class="font-display uppercase text-xl md:text-2xl tracking-tight text-anchor">{p.name}</h3>
              <p class="font-mono text-[10px] md:text-xs uppercase text-anchor/70 mt-1">{p.desc}</p>
              <div class="mt-3 flex gap-2 size-row">
                <span class="size-chip">S</span>
                <span class="size-chip">M</span>
                <span class="size-chip">L</span>
              </div>
              <div class="mt-3 sweet-slider">
                <div class="flex justify-between font-mono text-[9px] uppercase text-anchor/60 mb-1">
                  <span>Mild</span><span>Bold</span>
                </div>
                <div class="h-2 rounded-full bg-anchor/15 relative">
                  <div class="h-2 rounded-full bg-butterStrong border border-anchor" style="width:60%"></div>
                </div>
              </div>
              <a href="https://instagram.com/refresh.baghdad" target="_blank" rel="noopener" class="cta-btn mt-4 inline-flex items-center justify-center gap-2 rounded-full font-mono uppercase text-xs font-bold py-2.5 border-2 border-anchor">
                Order via Instagram
              </a>
            </div>
          </article>
        ))}
      </div>

      <div class="flex items-center justify-center gap-4 mt-10">
        <button id="prev-btn" aria-label="Previous product" class="w-12 h-12 rounded-full bg-butterStrong border-2 border-anchor flex items-center justify-center hover:-translate-y-1 transition-transform">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2C1B10" stroke-width="3"><path d="M15 6l-6 6 6 6"/></svg>
        </button>
        <button id="next-btn" aria-label="Next product" class="w-12 h-12 rounded-full bg-butterStrong border-2 border-anchor flex items-center justify-center hover:-translate-y-1 transition-transform">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2C1B10" stroke-width="3"><path d="M9 6l6 6-6 6"/></svg>
        </button>
      </div>
    </div>
  </div>

  <div class="mt-20 flex w-full">
    {Array.from({ length: 24 }).map((_, i) => (
      <div class={`flex-1 h-8 md:h-10 ${i % 2 === 0 ? 'bg-cream' : 'bg-anchor border border-cream/30'}`}></div>
    ))}
  </div>
</section>

<style>
  .carousel-card { width: 190px; }
  .card-inner { background: #FBF2E1; }
  .size-chip { font-family: 'Space Mono', monospace; font-size: 10px; border: 2px solid #2C1B10; border-radius: 999px; width: 26px; height: 26px; display: flex; align-items: center; justify-content: center; background: #fff; }
  .cta-btn { background: #F6C445; color: #2C1B10; }
  .carousel-card[data-active="true"] { width: 260px; transform: translateY(-18px) scale(1.05); z-index: 10; }
  .carousel-card[data-active="true"] .card-inner { background: #FCE9A8; }
  .carousel-card[data-active="true"] .price-chip { background: #F6A9C4; }
  .carousel-card[data-active="true"] .cta-btn { background: #2C1B10; color: #FBF2E1; }
  .carousel-card:not([data-active="true"]) { opacity: 0.85; transform: translateY(20px) scale(0.92); }
  .product-img { width: 120px; height: 120px; }
  .carousel-card[data-active="true"] .product-img { width: 160px; height: 160px; }
  @media (max-width: 768px) {
    .carousel-card { width: 150px; }
    .carousel-card[data-active="true"] { width: 200px; }
  }
</style>

<script>
  const cards = Array.from(document.querySelectorAll('.carousel-card'));
  let active = 1;
  function render() {
    cards.forEach((c, i) => {
      c.setAttribute('data-active', String(i === active));
    });
  }
  cards.forEach((c) => c.addEventListener('click', () => {
    active = parseInt(c.getAttribute('data-index') || '0');
    render();
  }));
  document.getElementById('prev-btn')?.addEventListener('click', () => {
    active = (active - 1 + cards.length) % cards.length;
    render();
  });
  document.getElementById('next-btn')?.addEventListener('click', () => {
    active = (active + 1) % cards.length;
    render();
  });
  render();
</script>