---
const profilePic = "https://scontent-ams2-1.cdninstagram.com/v/t51.82787-19/616235104_17913448284266823_7616257522537543457_n.jpg?stp=dst-jpg_s150x150_tt6&_nc_cat=109&ccb=7-5&_nc_sid=f7ccc5&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLnd3dy4xMDgwLkMzIn0%3D&_nc_ohc=Y6m5MGA-af4Q7kNvwEaaf8s&_nc_oc=AdoJYDmk00uO0U8jOWQmT_xgORL8ewmPPkv55QnIWQUEQJS4gD-HdvWGoQIvNKABwLU&_nc_zt=24&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=9zWxO4kA-G6T5PIw7a6lHQ&_nc_ss=7ba8c&oh=00_AQP8MVo4Z9DVcT9j5c_h2SQAtIev1cWF09Wlb0hFaPI2Cg&oe=6AC1F8FA";
---
<header class="fixed top-3 md:top-5 left-0 right-0 z-50 px-3 md:px-6" id="site-nav">
  <nav class="mx-auto max-w-[1200px] bg-cream/95 backdrop-blur border-2 border-anchor rounded-full shadow-[4px_4px_0_0_#2C1B10] flex items-center justify-between px-4 md:px-6 py-2.5 transition-all" aria-label="Main navigation">
    <div class="hidden md:flex items-center gap-6 font-mono uppercase text-xs tracking-wider">
      <a href="#about" class="hover:text-pinkDark transition-colors">About</a>
      <a href="#menu" class="hover:text-pinkDark transition-colors">Menu</a>
      <a href="#experience" class="hover:text-pinkDark transition-colors">Space</a>
    </div>

    <a href="#top" class="flex items-center gap-2 group" aria-label="Refresh Cafe home">
      <img src={profilePic} alt="Refresh Cafe logo" class="w-10 h-10 md:w-12 md:h-12 rounded-full border-2 border-anchor object-cover group-hover:animate-wiggle" width="48" height="48" />
      <span class="hidden sm:inline font-display uppercase text-lg tracking-tight">Refresh</span>
    </a>

    <div class="hidden md:flex items-center gap-4 font-mono uppercase text-xs tracking-wider">
      <a href="#visit" class="hover:text-pinkDark transition-colors">Visit</a>
      <a href="tel:+9647739999038" class="hover:text-pinkDark transition-colors">Call</a>
      <a href="https://instagram.com/refresh.baghdad" target="_blank" rel="noopener" class="bg-lavender text-anchor px-3 py-2 rounded-full border-2 border-anchor hover:-translate-y-0.5 transition-transform">IG</a>
    </div>

    <button id="menu-toggle" class="md:hidden w-10 h-10 rounded-full border-2 border-anchor flex items-center justify-center" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden md:hidden mt-3 mx-auto max-w-[1200px] bg-anchor text-cream rounded-3xl border-2 border-anchor p-6 flex flex-col gap-4 font-mono uppercase text-sm tracking-wider">
    <a href="#about" class="mobile-link">About</a>
    <a href="#menu" class="mobile-link">Menu</a>
    <a href="#experience" class="mobile-link">Space</a>
    <a href="#visit" class="mobile-link">Visit</a>
    <a href="tel:+9647739999038" class="mobile-link">Call Us</a>
    <a href="https://instagram.com/refresh.baghdad" target="_blank" rel="noopener" class="mobile-link">Instagram</a>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const isHidden = menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(isHidden));
  });
  const nav = document.getElementById('site-nav');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 30) nav?.classList.add('scale-[0.98]');
    else nav?.classList.remove('scale-[0.98]');
  });
</script>
<style>
  .mobile-link { padding: 0.5rem 0; border-bottom: 1px solid rgba(251,242,225,0.2); }
</style>