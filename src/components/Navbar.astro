---
const logoUrl = "https://scontent-ams2-1.cdninstagram.com/v/t51.82787-19/616235104_17913448284266823_7616257522537543457_n.jpg?stp=dst-jpg_s150x150_tt6&_nc_cat=109&ccb=7-5&_nc_sid=f7ccc5&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLnd3dy4xMDgwLkMzIn0%3D&_nc_ohc=Y6m5MGA-af4Q7kNvwEaaf8s&_nc_oc=AdoJYDmk00uO0U8jOWQmT_xgORL8ewmPPkv55QnIWQUEQJS4gD-HdvWGoQIvNKABwLU&_nc_zt=24&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=9zWxO4kA-G6T5PIw7a6lHQ&_nc_ss=7ba8c&oh=00_AQP8MVo4Z9DVcT9j5c_h2SQAtIev1cWF09Wlb0hFaPI2Cg&oe=6AC1F8FA";
---

<header class="fixed top-4 sm:top-6 inset-x-0 z-50 flex justify-center px-4 pointer-events-none">
  <nav class="pointer-events-auto bg-cream/95 backdrop-blur-md border-2 border-anchor rounded-full px-4 sm:px-6 py-2.5 sm:py-3 shadow-offset-dark flex items-center justify-between gap-4 sm:gap-8 max-w-4xl w-full transition-all duration-300 hover:translate-y-[-2px]">
    <!-- Left Navigation -->
    <div class="hidden md:flex items-center gap-6 text-xs font-mono font-bold uppercase tracking-wider text-anchor">
      <a href="#about" class="hover:text-popPink transition-colors">About Us</a>
      <a href="#menu" class="hover:text-popPink transition-colors">Diet Menu</a>
      <a href="#craft" class="hover:text-popPink transition-colors">The Craft</a>
    </div>

    <!-- Center Logo -->
    <a href="#" class="flex items-center gap-3 group mx-auto md:mx-0">
      <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-full overflow-hidden border-2 border-anchor shadow-sm transition-transform duration-300 group-hover:rotate-6 group-hover:scale-105 bg-butter">
        <img src={logoUrl} alt="Refresh Cafe Logo" class="w-full h-full object-cover" />
      </div>
      <div class="flex flex-col text-left">
        <span class="font-display text-lg sm:text-xl text-anchor leading-none tracking-tight">REFRESH</span>
        <span class="font-mono text-[9px] uppercase tracking-widest text-anchor/70 font-bold">1ST DIET CAFE • BGD</span>
      </div>
    </a>

    <!-- Right Navigation & Contact -->
    <div class="flex items-center gap-3 sm:gap-4">
      <a href="#reviews" class="hidden sm:inline-block font-mono text-xs font-bold uppercase tracking-wider hover:text-popPink transition-colors">
        Reviews
      </a>
      
      <a 
        href="tel:+9647739999038" 
        class="bg-butter hover:bg-butter-gold border-2 border-anchor text-anchor font-mono text-[11px] sm:text-xs font-extrabold uppercase px-3 sm:px-4 py-1.5 sm:py-2 rounded-full flex items-center gap-2 shadow-[2px_2px_0px_#27170E] active:translate-y-[1px] active:shadow-none transition-all"
      >
        <span>07739999038</span>
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      </a>

      <a 
        href="https://instagram.com/refresh.baghdad" 
        target="_blank" 
        rel="noopener noreferrer"
        class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-popPink border-2 border-anchor flex items-center justify-center text-anchor font-bold hover:rotate-12 transition-transform shadow-[2px_2px_0px_#27170E]"
        aria-label="Instagram Profile"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
