---
const logoSrc = "https://scontent-ams2-1.cdninstagram.com/v/t51.82787-19/616235104_17913448284266823_7616257522537543457_n.jpg?stp=dst-jpg_s150x150_tt6&_nc_cat=109&ccb=7-5&_nc_sid=f7ccc5&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLnd3dy4xMDgwLkMzIn0%3D&_nc_ohc=Y6m5MGA-af4Q7kNvwEaaf8s&_nc_oc=AdoJYDmk00uO0U8jOWQmT_xgORL8ewmPPkv55QnIWQUEQJS4gD-HdvWGoQIvNKABwLU&_nc_zt=24&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=9zWxO4kA-G6T5PIw7a6lHQ&_nc_ss=7ba8c&oh=00_AQP8MVo4Z9DVcT9j5c_h2SQAtIev1cWF09Wlb0hFaPI2Cg&oe=6AC1F8FA";
const instaUrl = "https://instagram.com/refresh.baghdad";
const mapUrl = "https://maps.google.com/?q=شارع+هيل+وزعفران+مجاور+دايت+ستي,+Baghdad,+Baghdad+Governorate,+10011,+Iraq";
---

<nav class="fixed top-4 left-0 right-0 z-50 px-4 lg:px-8">
  <div class="max-w-6xl mx-auto bg-base/95 backdrop-blur-md border-2 border-anchor/10 rounded-full px-6 py-3 shadow-sm flex items-center justify-between transition-transform duration-300">
    
    <!-- Left Links -->
    <div class="hidden md:flex items-center space-x-6 flex-1">
      <a href="#about" class="font-label text-xs font-bold tracking-widest uppercase hover:text-butter-strong transition-colors">About</a>
      <a href="#menu" class="font-label text-xs font-bold tracking-widest uppercase hover:text-butter-strong transition-colors">Menu</a>
      <a href="#experience" class="font-label text-xs font-bold tracking-widest uppercase hover:text-butter-strong transition-colors">Vibe</a>
    </div>

    <!-- Center Logo -->
    <a href="/" class="group relative flex-shrink-0">
      <div class="w-12 h-12 lg:w-14 lg:h-14 rounded-full overflow-hidden border-2 border-anchor/10 bg-white transition-transform duration-300 group-hover:rotate-6 group-hover:scale-110 shadow-sm">
        <img src={logoSrc} alt="Refresh Cafe Logo" class="w-full h-full object-cover" />
      </div>
    </a>

    <!-- Right Actions -->
    <div class="flex items-center justify-end space-x-4 flex-1">
      <a href={mapUrl} target="_blank" rel="noopener" class="hidden lg:block font-label text-xs font-bold tracking-widest uppercase hover:text-pop1 transition-colors">Visit Us</a>
      <a href={instaUrl} target="_blank" rel="noopener" class="w-10 h-10 bg-butter text-anchor rounded-full flex items-center justify-center hover:bg-butter-strong hover:text-base transition-colors shadow-hard-dark hover:shadow-hard-pink hover:-translate-y-1 duration-200">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772 4.902 4.902 0 011.772-1.153c.636-.247 1.363-.416 2.427-.465C9.51 2.013 9.864 2 12.315 2zM12 7a5 5 0 100 10 5 5 0 000-10zm0 8.117a3.117 3.117 0 110-6.234 3.117 3.117 0 010 6.234zm5.162-8.283a1.2 1.2 0 100 2.4 1.2 1.2 0 000-2.4z" clip-rule="evenodd" />
        </svg>
      </a>
      
      <!-- Mobile Menu Button (Visual Only for static demo) -->
      <button class="md:hidden w-10 h-10 flex items-center justify-center text-anchor" aria-label="Open Menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
    
  </div>
</nav>