<section id="about" class="relative bg-cream py-24 md:py-36 overflow-hidden">
  <img src={cup} alt="A warm cup at Refresh Cafe" loading="lazy" width="180" height="180"
    class="hidden md:block absolute left-6 top-16 w-40 h-40 object-cover rounded-3xl border-[6px] border-cream shadow-[6px_6px_0_0_#2C1B10] rotate-[-6deg]" />
  <img src={corner} alt="Quiet corner moments at Refresh" loading="lazy" width="180" height="180"
    class="hidden md:block absolute right-8 bottom-10 w-44 h-44 object-cover rounded-3xl border-[6px] border-cream shadow-[6px_6px_0_0_#2C1B10] rotate-[6deg]" />

  <div class="max-w-3xl mx-auto px-6 text-center reveal">
    <p class="font-mono uppercase text-xs tracking-[0.2em] text-anchorSoft mb-5">About Us</p>
    <p class="font-display uppercase text-anchor text-3xl md:text-5xl leading-[0.95] tracking-tight">
      We're Baghdad's first diet cafe — proof that a real diet doesn't mean giving up real taste.
    </p>
    <div class="mt-8">
      <a href="#menu" class="inline-flex items-center gap-3 bg-anchor text-cream font-mono uppercase text-sm font-bold px-6 py-3 rounded-full shadow-[4px_4px_0_0_#F6A9C4] hover:shadow-[6px_6px_0_0_#F6A9C4] hover:-translate-y-0.5 transition-all">
        Meet The Menu
        <span class="w-6 h-6 rounded-full bg-butterStrong text-anchor flex items-center justify-center">→</span>
      </a>
    </div>
  </div>
</section>