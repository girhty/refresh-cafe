---
const voices = [
  {
    initials: 'RB',
    name: 'Refresh Cafe',
    role: '@refresh.baghdad',
    quote: "Refresh, without the guilt. Diet drinks with a flavor that's actually worth trying.",
    color: 'bg-pink'
  },
  {
    initials: 'IM',
    name: 'Iced Matcha',
    role: 'Fan favorite',
    quote: 'A little green, a lot of refresh. Creamy, smooth, made to refresh your day.',
    color: 'bg-lavender'
  },
  {
    initials: 'DL',
    name: 'Diet Latte',
    role: 'Most reordered',
    quote: "Same flavor you love, without the added calories. That's the whole idea.",
    color: 'bg-butterStrong'
  }
];
---
<section id="reviews" class="relative bg-cream py-24 md:py-32 overflow-hidden">
  <div class="w-full flex opacity-20 mb-16">
    {Array.from({ length: 30 }).map((_, i) => (
      <div class={`flex-1 h-6 ${i % 2 === 0 ? 'bg-anchor' : 'bg-cream'}`}></div>
    ))}
  </div>

  <div class="max-w-[1200px] mx-auto px-5 md:px-8">
    <h2 class="font-display uppercase text-anchor text-4xl md:text-6xl text-center leading-[0.92] tracking-tight mb-4 reveal">
      Loved On Google.<br/>Loved On Instagram.
    </h2>
    <p class="text-center font-mono uppercase text-xs tracking-[0.2em] text-anchorSoft mb-16">5.0 ★★★★★ Rating · Community Voices</p>

    <div id="featured-review" class="relative bg-butter border-2 border-anchor rounded-[32px] p-8 md:p-12 grid md:grid-cols-[auto,1fr] gap-8 items-center mb-10 reveal">
      <span class="absolute top-4 right-8 font-display text-8xl md:text-9xl text-lavender leading-none select-none">”</span>
      <div class="w-24 h-24 md:w-28 md:h-28 rounded-full bg-pink border-2 border-anchor flex items-center justify-center font-display text-2xl text-anchor" id="feat-avatar">RB</div>
      <div>
        <div class="flex gap-1 mb-4 text-gold text-lg" aria-label="5 out of 5 stars">★★★★★</div>
        <p class="font-display uppercase text-xl md:text-3xl text-anchor leading-tight mb-6" id="feat-quote">
          Refresh, without the guilt. Diet drinks with a flavor that's actually worth trying.
        </p>
        <p class="font-mono text-xs uppercase text-anchorSoft" id="feat-name">Refresh Cafe — @refresh.baghdad</p>
      </div>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {voices.map((v, i) => (
        <button
          class="voice-card text-left bg-cream border-2 border-anchor rounded-3xl p-6 hover:-translate-y-1 hover:rotate-1 transition-transform"
          data-quote={v.quote}
          data-name={`${v.name} — ${v.role}`}
          data-initials={v.initials}
        >
          <div class={`w-12 h-12 rounded-full ${v.color} border-2 border-anchor flex items-center justify-center font-display text-sm mb-4`}>{v.initials}</div>
          <p class="font-mono text-xs uppercase text-anchorSoft mb-1">{v.name}</p>
          <p class="text-xs text-anchorSoft/70 mb-3">{v.role}</p>
          <p class="text-sm text-anchor line-clamp-3">{v.quote}</p>
        </button>
      ))}
    </div>
  </div>
</section>

<script>
  const cards = Array.from(document.querySelectorAll('.voice-card'));
  const featQuote = document.getElementById('feat-quote');
  const featName = document.getElementById('feat-name');
  const featAvatar = document.getElementById('feat-avatar');
  cards.forEach((c) => c.addEventListener('click', () => {
    if (featQuote) featQuote.textContent = c.getAttribute('data-quote') || '';
    if (featName) featName.textContent = c.getAttribute('data-name') || '';
    if (featAvatar) featAvatar.textContent = c.getAttribute('data-initials') || '';
  }));
</script>