---
<section class="relative bg-creamDark py-24 md:py-32 overflow-hidden">
  <div class="max-w-[1300px] mx-auto px-5 md:px-8">
    <div class="flex flex-col md:flex-row md:justify-between md:items-end gap-6 mb-14 reveal">
      <div>
        <p class="font-mono uppercase text-xs tracking-[0.2em] text-anchorSoft mb-4">The Craft</p>
        <h2 class="font-display uppercase text-anchor text-4xl md:text-6xl leading-[0.92] tracking-tight">
          Simple Ingredients.<br/>Careful Hands.
        </h2>
      </div>
      <div class="flex items-start gap-4 max-w-xs">
        <p class="text-anchorSoft text-sm">No shortcuts, no artificial promises — just a process built to keep every drink honest.</p>
        <Checker colorA="bg-butter" colorB="bg-lavender" cols={3} rows={3} size="w-3 h-3" />
      </div>
    </div>

    <div class="bg-anchor rounded-[32px] border-2 border-anchor p-6 md:p-10 text-cream reveal">
      <div id="craft-feature" class="grid md:grid-cols-2 gap-10 items-center">
        <div>
          <span class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-lavender text-anchor font-mono font-bold text-sm mb-4" id="craft-num">01</span>
          <p class="font-mono uppercase text-xs tracking-[0.2em] text-cream/60 mb-2" id="craft-label">Select</p>
          <h3 class="font-display uppercase text-3xl md:text-4xl text-butter leading-tight mb-4" id="craft-title">Ingredients Worth Choosing</h3>
          <p class="text-cream/80 text-sm md:text-base max-w-md" id="craft-body">Every drink starts with quality picks — real matcha, real dates, real milk — chosen for balance, not shortcuts.</p>
        </div>
        <div class="relative">
          <div class="absolute inset-0 bg-pink rounded-3xl translate-x-3.5 translate-y-3.5"></div>
          <img id="craft-img" src={steps[0].img} alt={steps[0].title} loading="lazy" width="480" height="340" class="relative rounded-3xl border-2 border-anchor w-full h-64 md:h-72 object-cover transition-opacity duration-400" />
        </div>
      </div>

      <div class="mt-10 pt-8 border-t border-cream/20 flex flex-wrap gap-x-8 gap-y-4">
        {steps.map((s, i) => (
          <button
            class="craft-tab font-mono uppercase text-xs md:text-sm tracking-wider text-cream/50 hover:text-butter transition-colors data-active:text-butter"
            data-index={i}
            data-num={s.num}
            data-label={s.label}
            data-title={s.title}
            data-body={s.body}
            data-img={s.img}
          >
            {s.title} <span class="opacity-60">{s.num}</span>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const tabs = Array.from(document.querySelectorAll('.craft-tab'));
  const num = document.getElementById('craft-num');
  const label = document.getElementById('craft-label');
  const title = document.getElementById('craft-title');
  const body = document.getElementById('craft-body');
  const img = document.getElementById('craft-img');

  function setActive(tab) {
    tabs.forEach((t) => t.classList.remove('text-butter'));
    tab.classList.add('text-butter');
    if (img) img.style.opacity = '0';
    setTimeout(() => {
      if (num) num.textContent = tab.getAttribute('data-num') || '';
      if (label) label.textContent = tab.getAttribute('data-label') || '';
      if (title) title.textContent = tab.getAttribute('data-title') || '';
      if (body) body.textContent = tab.getAttribute('data-body') || '';
      if (img) {
        img.setAttribute('src', tab.getAttribute('data-img') || '');
        img.setAttribute('alt', tab.getAttribute('data-title') || '');
        img.style.opacity = '1';
      }
    }, 200);
  }
  tabs.forEach((tab) => tab.addEventListener('click', () => setActive(tab)));
  if (tabs[0]) setActive(tabs[0]);
</script>