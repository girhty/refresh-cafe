---
interface Props {
  words: string[];
  bg?: string;
  textColor?: string;
  tilt?: string;
  reverse?: boolean;
}
const { words, bg = 'bg-pink', textColor = 'text-anchor', tilt = '-rotate-2', reverse = false } = Astro.props;
const line = words.join(' \u2726 ') + ' \u2726 ';
const repeated = line + line;
---
<div class={`relative w-full overflow-hidden ${bg} border-y-2 border-anchor py-4 md:py-6 ${tilt} scale-110`}>
  <div class={`flex whitespace-nowrap ${reverse ? 'animate-marqueeRev' : 'animate-marquee'} hover:[animation-play-state:paused]`}>
    <span class={`font-display uppercase text-3xl md:text-5xl px-3 tracking-tight ${textColor}`}>{repeated}</span>
    <span class={`font-display uppercase text-3xl md:text-5xl px-3 tracking-tight ${textColor}`}>{repeated}</span>
  </div>
</div>