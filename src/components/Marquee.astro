---
interface Props {
  text: string;
  bgColor: string;
  textColor: string;
  reverse?: boolean;
}

const { text, bgColor, textColor, reverse = false } = Astro.props;

// Repeat text enough times to fill screen and scroll seamlessly
const items = Array(8).fill(text);
---

<div class={`relative w-[110%] -left-[5%] py-3 ${bgColor} ${textColor} transform ${reverse ? 'rotate-2' : '-rotate-2'} shadow-md overflow-hidden flex z-20 border-y-2 border-anchor/90`}>
  <div class={`flex whitespace-nowrap ${reverse ? 'animate-marquee-reverse' : 'animate-marquee'} hover:[animation-duration:40s]`}>
    {items.map((item) => (
      <div class="flex items-center">
        <span class="font-display text-2xl md:text-4xl tracking-wider px-4">{item}</span>
        <span class="text-xl md:text-3xl px-4">★</span>
      </div>
    ))}
  </div>
  <div class={`flex whitespace-nowrap ${reverse ? 'animate-marquee-reverse' : 'animate-marquee'} hover:[animation-duration:40s] absolute top-3 left-full`}>
    {items.map((item) => (
      <div class="flex items-center">
        <span class="font-display text-2xl md:text-4xl tracking-wider px-4">{item}</span>
        <span class="text-xl md:text-3xl px-4">★</span>
      </div>
    ))}
  </div>
</div>