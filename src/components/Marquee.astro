---
const { items = ['Refresh'], color = 'pink', reverse = false } = Astro.props;
const bg = color === 'butter' ? 'bg-butter' : color === 'lavender' ? 'bg-lavenderpop' : 'bg-pinkpop';
const trackClass = reverse ? 'animate-marquee-reverse' : 'animate-marquee';
---

<div class={`relative z-20 -mx-[5vw] w-[110vw] -rotate-2 overflow-hidden border-y-2 border-anchor ${bg} py-3 md:py-4`}>
  <div class={`marquee-track flex w-max items-center ${trackClass}`}>
    {[0, 1].map((half) => (
      <div class="flex shrink-0 items-center" aria-hidden={half === 1 ? 'true' : 'false'}>
        {items.map((item) => (
          <span class="flex items-center">
            <span class="px-4 font-display text-3xl uppercase leading-none text-anchor md:text-5xl">{item}</span>
            <span class="font-mono text-xl text-anchor md:text-2xl">*</span>
          </span>
        ))}
      </div>
    ))}
  </div>
</div>