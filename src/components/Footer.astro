---
const matcha = "https://scontent-ams2-1.cdninstagram.com/v/t51.82787-15/794032623_17948492067266823_7578226426693012433_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=107&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0xJUFMuYmVzdF9pbWFnZV91cmxnZW4uQzMifQ%3D%3D&_nc_ohc=NYjctEAvy7cQ7kNvwFHmiSP&_nc_oc=Adph5_RVWf2icuScJwmhAxHO8P_RB8oZUWFhxo62FNyTEbrzne6WhCP-EQgxmMBZNo4&_nc_zt=23&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=cO0pZhQ1iJyLHDhTQ7H9Fw&_nc_ss=7ba8c&oh=00_AQNZ0AR79KsE0exUGsrTSfuBfJpq0kzO5sgxGTwTZIa6AA&oe=6AC1E3F9";
const profilePic = "https://scontent-ams2-1.cdninstagram.com/v/t51.82787-19/616235104_17913448284266823_7616257522537543457_n.jpg?stp=dst-jpg_s150x150_tt6&_nc_cat=109&ccb=7-5&_nc_sid=f7ccc5&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLnd3dy4xMDgwLkMzIn0%3D&_nc_ohc=Y6m5MGA-af4Q7kNvwEaaf8s&_nc_oc=AdoJYDmk00uO0U8jOWQmT_xgORL8ewmPPkv55QnIWQUEQJS4gD-HdvWGoQIvNKABwLU&_nc_zt=24&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=9zWxO4kA-G6T5PIw7a6lHQ&_nc_ss=7ba8c&oh=00_AQP8MVo4Z9DVcT9j5c_h2SQAtIev1cWF09Wlb0hFaPI2Cg&oe=6AC1F8FA";
---
<section id="visit" class="relative bg-anchor pt-24 md:pt-32 pb-10 overflow-hidden text-cream">
  <div class="max-w-[1300px] mx-auto px-5 md:px-8 grid md:grid-cols-2 gap-14 items-center mb-20">
    <div class="relative h-[300px] md:h-[420px] flex items-center justify-center order-2 md:order-1">
      <div class="absolute w-64 h-64 md:w-80 md:h-80 bg-anchorSoft rounded-blob"></div>
      <img src={matcha} alt="Refresh Cafe signature iced matcha" loading="lazy" width="280" height="280"
        class="relative rounded-full w-48 h-48 md:w-64 md:h-64 object-cover border-4 border-butter shadow-[10px_10px_0_0_rgba(0,0,0,0.3)] rotate-[5deg] animate-float" style="--tilt:5deg" />
      <div class="absolute top-6 right-10 w-5 h-5 rounded-full bg-pink border-2 border-cream animate-float" style="animation-delay:0.3s"></div>
      <div class="absolute bottom-10 left-6 w-4 h-4 rounded-sm bg-lavender border-2 border-cream animate-float" style="animation-delay:0.7s"></div>
    </div>

    <div class="flex flex-col gap-6 order-1 md:order-2">
      <div class="bg-cream text-anchor rounded-3xl border-2 border-anchor p-6 md:p-8">
        <p class="font-mono uppercase text-xs tracking-[0.2em] text-anchorSoft mb-3">Find Us</p>
        <p class="font-display uppercase text-xl md:text-2xl leading-snug mb-4">
          المنصور – الداوودي<br/>شارع مطعم هيل وزعفران<br/>مجاور مطعم دايت ستي، بغداد
        </p>
        <a href="https://maps.google.com/?q=Refresh+Cafe+Baghdad" target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-lavender border-2 border-anchor rounded-full px-4 py-2 font-mono text-xs font-bold uppercase hover:-translate-y-0.5 transition-transform">
          📍 Open in Maps
        </a>
      </div>

      <div class="bg-butter text-anchor rounded-3xl border-2 border-anchor p-6 md:p-8">
        <p class="font-mono uppercase text-xs tracking-[0.2em] text-anchorSoft mb-3">See You There</p>
        <div class="flex items-center gap-3 mb-2">
          <span class="font-display uppercase text-xl md:text-2xl">Open Now</span>
          <span class="w-3 h-3 rounded-full bg-green-600 border-2 border-anchor inline-block"></span>
        </div>
        <p class="text-sm text-anchorSoft">Hours vary by day — give us a call and we'll confirm before you head over.</p>
        <a href="tel:+9647739999038" class="inline-flex items-center gap-2 mt-4 bg-anchor text-cream border-2 border-anchor rounded-full px-4 py-2 font-mono text-xs font-bold uppercase hover:-translate-y-0.5 transition-transform">
          📞 +964 773 999 9038
        </a>
      </div>
    </div>
  </div>

  <div class="max-w-[1300px] mx-auto px-5 md:px-8 pt-10 border-t border-cream/15 grid md:grid-cols-4 gap-10 pb-10">
    <div>
      <div class="flex items-center gap-2 mb-3">
        <img src={profilePic} alt="Refresh Cafe logo" width="40" height="40" class="w-10 h-10 rounded-full border-2 border-cream object-cover" />
        <span class="font-display uppercase text-lg">Refresh</span>
      </div>
      <p class="text-cream/60 text-sm max-w-xs">Baghdad's first diet cafe — real flavor, real balance, every single cup.</p>
    </div>

    <div>
      <p class="font-mono uppercase text-xs tracking-[0.2em] text-cream/50 mb-4">Quick Links</p>
      <ul class="space-y-2 text-sm text-cream/80">
        <li><a href="#about" class="hover:text-butter">About</a></li>
        <li><a href="#menu" class="hover:text-butter">Menu</a></li>
        <li><a href="#experience" class="hover:text-butter">Space</a></li>
      </ul>
    </div>

    <div>
      <p class="font-mono uppercase text-xs tracking-[0.2em] text-cream/50 mb-4">Visit</p>
      <ul class="space-y-2 text-sm text-cream/80">
        <li>Baghdad, Iraq</li>
        <li><a href="tel:+9647739999038" class="hover:text-butter">+964 773 999 9038</a></li>
      </ul>
    </div>

    <div>
      <p class="font-mono uppercase text-xs tracking-[0.2em] text-cream/50 mb-4">Follow</p>
      <a href="https://instagram.com/refresh.baghdad" target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-cream text-anchor rounded-full px-4 py-2 font-mono text-xs font-bold uppercase hover:-translate-y-0.5 transition-transform">
        📷 @refresh.baghdad
      </a>
      <p class="text-cream/40 text-xs mt-4">3.5K+ followers</p>
    </div>
  </div>

  <p class="text-center text-cream/40 text-xs pb-6">© {new Date().getFullYear()} Refresh Cafe · Baghdad · All rights reserved.</p>
</section>