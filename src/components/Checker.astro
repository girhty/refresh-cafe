---
interface Props {
  colorA?: string;
  colorB?: string;
  cols?: number;
  rows?: number;
  size?: string;
  class?: string;
}
const { colorA = 'bg-butterStrong', colorB = 'bg-lavender', cols = 8, rows = 2, size = 'w-4 h-4 md:w-5 md:h-5', class: klass = '' } = Astro.props;
const cells = Array.from({ length: cols * rows });
---
<div class={`inline-grid ${klass}`} style={`grid-template-columns: repeat(${cols}, minmax(0,1fr));`}>
  {cells.map((_, i) => {
    const row = Math.floor(i / cols);
    const col = i % cols;
    const isA = (row + col) % 2 === 0;
    const delay = (i * 40) % 700;
    return (
      <div
        class={`checker-cell opacity-0 ${size} ${isA ? colorA : colorB}`}
        style={`transition-delay:${delay}ms;`}
      ></div>
    );
  })}
</div>