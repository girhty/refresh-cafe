---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Refresh Cafe | First Diet & Healthy Specialty Cafe in Baghdad",
  description = "The first diet cafe in Baghdad offering the true balance of guilt-free indulgence, specialty cold brew, protein shakes & iced matcha. Located in Al-Mansour."
} = Astro.props;

const logoUrl = "https://scontent-ams2-1.cdninstagram.com/v/t51.82787-19/616235104_17913448284266823_7616257522537543457_n.jpg?stp=dst-jpg_s150x150_tt6&_nc_cat=109&ccb=7-5&_nc_sid=f7ccc5&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLnd3dy4xMDgwLkMzIn0%3D&_nc_ohc=Y6m5MGA-af4Q7kNvwEaaf8s&_nc_oc=AdoJYDmk00uO0U8jOWQmT_xgORL8ewmPPkv55QnIWQUEQJS4gD-HdvWGoQIvNKABwLU&_nc_zt=24&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=9zWxO4kA-G6T5PIw7a6lHQ&_nc_ss=7ba8c&oh=00_AQP8MVo4Z9DVcT9j5c_h2SQAtIev1cWF09Wlb0hFaPI2Cg&oe=6AC1F8FA";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={logoUrl} />
    <meta property="og:type" content="website" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cabinet+Grotesk:wght@800;900&family=JetBrains+Mono:wght@500;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Local Business Schema -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "CafeOrCoffeeShop",
        "name": "Refresh Cafe",
        "image": "https://scontent-ams2-1.cdninstagram.com/v/t51.82787-19/616235104_17913448284266823_7616257522537543457_n.jpg",
        "telephone": "+9647739999038",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Al-Mansour, Al-Dawoodi, Hayl & Zaafaran St, Next to Diet City",
          "addressLocality": "Baghdad",
          "postalCode": "10011",
          "addressCountry": "IQ"
        },
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "5.0",
          "reviewCount": "5"
        },
        "servesCuisine": ["Diet Drinks", "Specialty Coffee", "Iced Matcha", "Healthy Shakes"]
      }
    </script>
  </head>
  <body class="bg-cream text-anchor font-sans antialiased overflow-x-hidden selection:bg-butter selection:text-anchor">
    <slot />
  </body>
</html>

<style is:global>
  h1, h2, h3, .font-display {
    font-family: 'Cabinet Grotesk', Impact, sans-serif;
    letter-spacing: -0.03em;
    line-height: 0.95;
    text-transform: uppercase;
  }
  .font-mono {
    font-family: 'JetBrains Mono', monospace;
  }
  
  /* Hard tactile buttons & cards */
  .pixel-checker-sm {
    background-image: 
      linear-gradient(45deg, #FFE999 25%, transparent 25%), 
      linear-gradient(-45deg, #FFE999 25%, transparent 25%), 
      linear-gradient(45deg, transparent 75%, #FFE999 75%), 
      linear-gradient(-45deg, transparent 75%, #FFE999 75%);
    background-size: 16px 16px;
    background-position: 0 0, 0 8px, 8px -8px, -8px 0px;
    background-color: #C5CAFE;
  }

  .pixel-checker-dark {
    background-image: 
      linear-gradient(45deg, #27170E 25%, transparent 25%), 
      linear-gradient(-45deg, #27170E 25%, transparent 25%), 
      linear-gradient(45deg, transparent 75%, #27170E 75%), 
      linear-gradient(-45deg, transparent 75%, #27170E 75%);
    background-size: 24px 24px;
    background-position: 0 0, 0 12px, 12px -12px, -12px 0px;
    background-color: #FFFDF9;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-marquee-left,
    .animate-marquee-right,
    .animate-float-slow {
      animation: none !important;
    }
  }
</style>