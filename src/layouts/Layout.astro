---
const title = Astro.props.title || 'Refresh Cafe — First Diet Café in Baghdad';
const description = Astro.props.description || 'Refresh Cafe is Baghdad’s first diet café. Specialty matcha, cold brew, diet lattes and date shakes made for pleasure and health.';
const profilePic = 'https://scontent-ams2-1.cdninstagram.com/v/t51.82787-19/616235104_17913448284266823_7616257522537543457_n.jpg?stp=dst-jpg_s150x150_tt6&_nc_cat=109&ccb=7-5&_nc_sid=f7ccc5&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLnd3dy4xMDgwLkMzIn0%3D&_nc_ohc=Y6m5MGA-af4Q7kNvwEaaf8s&_nc_oc=AdoJYDmk00uO0U8jOWQmT_xgORL8ewmPPkv55QnIWQUEQJS4gD-HdvWGoQIvNKABwLU&_nc_zt=24&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=9zWxO4kA-G6T5PIw7a6lHQ&_nc_ss=7ba8c&oh=00_AQP8MVo4Z9DVcT9j5c_h2SQAtIev1cWF09Wlb0hFaPI2Cg&oe=6AC1F8FA';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CafeOrCoffeeShop',
  name: 'Refresh Cafe',
  image: profilePic,
  telephone: '+964 773 999 9038',
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '5',
    reviewCount: '5'
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'شارع هيل وزعفران مجاور دايت ستي',
    addressLocality: 'Baghdad',
    addressCountry: 'IQ'
  },
  sameAs: ['https://www.instagram.com/refresh.baghdad/']
};
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={profilePic} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Space+Mono:wght@400;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</head>
<body class="bg-cream font-body text-anchor antialiased">
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-butter focus:px-5 focus:py-3 focus:font-mono focus:text-xs focus:uppercase focus:tracking-widest focus:text-anchor focus:shadow-hard">Skip to content</a>
  <slot />
  <script is:inline>
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const revealEls = document.querySelectorAll('.reveal');
    const cellEls = document.querySelectorAll('.checker-cell');

    if (reduced) {
      revealEls.forEach((el) => el.classList.add('is-visible'));
      cellEls.forEach((el) => el.classList.add('is-visible'));
    } else {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });
      revealEls.forEach((el) => io.observe(el));
      cellEls.forEach((el) => io.observe(el));
    }
  </script>
  <style is:global>
    html {
      scroll-behavior: smooth;
    }
    body {
      font-family: 'Inter', sans-serif;
      background: #FDF8F0;
      color: #2A170D;
    }
    ::selection {
      background: #F6D06B;
      color: #2A170D;
    }
    :focus-visible {
      outline: 3px solid #F7A0B2;
      outline-offset: 2px;
    }
    .reveal {
      opacity: 0;
      transform: translateY(30px);
      transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .reveal.is-visible {
      opacity: 1;
      transform: none;
    }
    .checker-cell {
      opacity: 0;
      transform: scale(0.3);
      transition: opacity 0.5s ease, transform 0.5s ease;
    }
    .checker-cell.is-visible {
      opacity: 1;
      transform: scale(1);
    }
    .marquee-track:hover {
      animation-play-state: paused;
    }
    @media (prefers-reduced-motion: reduce) {
      .reveal, .checker-cell {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
      .animate-marquee, .animate-marquee-reverse, .animate-float, .animate-wiggle {
        animation: none !important;
      }
    }
  </style>
</body>
</html>