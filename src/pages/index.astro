---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Checker from '../components/Checker.astro';
import Marquee from '../components/Marquee.astro';
import Card from '../components/Card.astro';

const profilePic = 'https://scontent-ams2-1.cdninstagram.com/v/t51.82787-19/616235104_17913448284266823_7616257522537543457_n.jpg?stp=dst-jpg_s150x150_tt6&_nc_cat=109&ccb=7-5&_nc_sid=f7ccc5&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLnd3dy4xMDgwLkMzIn0%3D&_nc_ohc=Y6m5MGA-af4Q7kNvwEaaf8s&_nc_oc=AdoJYDmk00uO0U8jOWQmT_xgORL8ewmPPkv55QnIWQUEQJS4gD-HdvWGoQIvNKABwLU&_nc_zt=24&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=9zWxO4kA-G6T5PIw7a6lHQ&_nc_ss=7ba8c&oh=00_AQP8MVo4Z9DVcT9j5c_h2SQAtIev1cWF09Wlb0hFaPI2Cg&oe=6AC1F8FA';
const instagramUrl = 'https://www.instagram.com/refresh.baghdad/';
const phoneDisplay = '0773 999 9038';
const phoneLink = 'tel:+9647739999038';
const mapLink = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent('Refresh Cafe شارع هيل وزعفران مجاور دايت ستي Baghdad');

const IMG = {
  matcha: 'https://scontent-ams2-1.cdninstagram.com/v/t51.82787-15/794032623_17948492067266823_7578226426693012433_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=107&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0xJUFMuYmVzdF9pbWFnZV91cmxnZW4uQzMifQ%3D%3D&_nc_ohc=NYjctEAvy7cQ7kNvwFHmiSP&_nc_oc=Adph5_RVWf2icuScJwmhAxHO8P_RB8oZUWFhxo62FNyTEbrzne6WhCP-EQgxmMBZNo4&_nc_zt=23&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=cO0pZhQ1iJyLHDhTQ7H9Fw&_nc_ss=7ba8c&oh=00_AQNZ0AR79KsE0exUGsrTSfuBfJpq0kzO5sgxGTwTZIa6AA&oe=6AC1E3F9',
  latte: 'https://scontent-ams2-1.cdninstagram.com/v/t51.82787-15/776718665_17946476757266823_3092288458190742280_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=101&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0xJUFMuYmVzdF9pbWFnZV91cmxnZW4uQzMifQ%3D%3D&_nc_ohc=Z3Cwie8nHwkQ7kNvwEwnhC4&_nc_oc=AdrQtodvlccHUvaeHo7b2bHkP3djMDX5TGMqNPIEaS9OoQkSxtvSUUBXLkte7oWjd2U&_nc_zt=23&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=cO0pZhQ1iJyLHDhTQ7H9Fw&_nc_ss=7ba8c&oh=00_AQPZHPFo9YZI5fw4pcYvmq97sLXDnxDJuow6lCPZGeA_5w&oe=6AC1E3AE',
  shake: 'https://scontent-ams2-1.cdninstagram.com/v/t51.82787-15/779145745_17946355131266823_6141674129459981372_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=105&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0FST1VTRUxfSVRFTS5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=ZCuU1PJApxgQ7kNvwER0Rna&_nc_oc=AdrMjokD5-9uOyDrezyV0GHSK0I8cT2KHL-hJPKOoiu3Raqa6aSXuijd5D9o71n3MsM&_nc_zt=23&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=cO0pZhQ1iJyLHDhTQ7H9Fw&_nc_ss=7ba8c&oh=00_AQOEJxRfbfvpkJTM8TPNKFYqjff2Qld_qrU6S8fEcTIBzw&oe=6AC1F0DE',
  coldbrew: 'https://scontent-ams2-1.cdninstagram.com/v/t15.5256-10/780949353_1596279635189869_1153598757660377946_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=104&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0xJUFMuYmVzdF9pbWFnZV91cmxnZW4uQzMifQ%3D%3D&_nc_ohc=siUSfyJphccQ7kNvwGXGNh3&_nc_oc=Adp5ClswIvrBuk9UMFF2r4wynoSF4eYDZSTdD_YMF--XlB9UJktW_sGhTUrsOYx9e-4&_nc_zt=23&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=cO0pZhQ1iJyLHDhTQ7H9Fw&_nc_ss=7ba8c&oh=00_AQMAFgIL7451-Jw8cT4NeJMKx_lYUvv1mzkKJx0-ZQRwJQ&oe=6AC1E8E3',
  warm: 'https://scontent-ams2-1.cdninstagram.com/v/t51.82787-15/769528731_17944263906266823_5881257777323666093_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=107&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0xJUFMuYmVzdF9pbWFnZV91cmxnZW4uQzMifQ%3D%3D&_nc_ohc=vVSHWsKezj0Q7kNvwE_1F6T&_nc_oc=Adok7oQj-l3Gd_lR_qiVyXSWxPASNVHNYPpo-GjqNhQIcMl9Q99fI4i49V1ljliV6AQ&_nc_zt=23&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=cO0pZhQ1iJyLHDhTQ7H9Fw&_nc_ss=7ba8c&oh=00_AQOeJDlml8W9lO8tUrbaursvvnHcMa0Y2SevcE1T8VRSEA&oe=6AC20722',
  energy: 'https://scontent-ams2-1.cdninstagram.com/v/t39.30808-6/767002513_122200920686767471_8275407980521003658_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=101&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiRkVFRC5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=t5w9PZbMXw8Q7kNvwFkqShs&_nc_oc=AdokUgTqNqOfWBbstQA1iw_zORgRBJ36AUuRVjlHhmzTwJZXbpoDadb2MvSpxfJoQ5w&_nc_zt=23&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=cO0pZhQ1iJyLHDhTQ7H9Fw&_nc_ss=7ba8c&oh=00_AQNJbZGpSvaU6U3I2Rul9p9sSj8VgYuQb4OqJTW6diWT6A&oe=6AC20D4F',
  summer: 'https://scontent-ams2-1.cdninstagram.com/v/t51.82787-15/768926201_17943806736266823_197649942369072822_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=101&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiRkVFRC5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=ojwx0PIcx6cQ7kNvwHakwM5&_nc_oc=AdrohkdxSnOG6lhDI_JLSki2F1vfuGJyFUd_91C5MdYPxCNTuNWuZSYHqFbVIOesk9o&_nc_zt=23&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=cO0pZhQ1iJyLHDhTQ7H9Fw&_nc_ss=7ba8c&oh=00_AQMVVpIOnQJ0DE6BAofxM9ijXZvU7PjybVQS_hIDR7eWvQ&oe=6AC1F8E0',
  quiet: 'https://scontent-ams2-1.cdninstagram.com/v/t51.82787-15/765175304_17943473940266823_6613519965218726446_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=109&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiRkVFRC5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=zSryh1NaIckQ7kNvwG3zLik&_nc_oc=AdrpU3kvQbihxR-w3b4-hCgu7PSCvhRJTZgkZeOedF8g24BxUt28SAiTvYe38Ker59M&_nc_zt=23&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=cO0pZhQ1iJyLHDhTQ7H9Fw&_nc_ss=7ba8c&oh=00_AQPucM398AbbJ78lpFmU8ao3dJSwi002mEO_9IbhV1y5QQ&oe=6AC1EAF1',
  guiltfree: 'https://scontent-ams2-1.cdninstagram.com/v/t51.82787-15/790945593_17948049024266823_2890493031717478853_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=111&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiRkVFRC5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=FhbUhzxN2HkQ7kNvwFGcrDW&_nc_oc=AdpaaZFiyCcqOLpShJDnz-n7lnXObChWDOXvfl93KblLLRGRxbi4yu-JfE_DFpq12a8&_nc_zt=23&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=cO0pZhQ1iJyLHDhTQ7H9Fw&_nc_ss=7ba8c&oh=00_AQNnspfx2i7baTwyYDOCjAHLgA7XM2mc4qUEphSCplP54w&oe=6AC20B5C'
};

const products = [
  { name: 'Diet Latte', tag: 'LATTE', image: IMG.latte, desc: 'Same coffee love, lower calorie count.', chip: 'ASK IN STORE' },
  { name: 'Iced Matcha', tag: 'MATCHA', image: IMG.matcha, desc: 'Toasted, creamy and made to refresh.', chip: 'ASK IN STORE' },
  { name: 'Date Shake', tag: 'SHAKE', image: IMG.shake, desc: 'Dates, milk and a Baghdad smile.', chip: 'ASK IN STORE' },
  { name: 'Cold Brew', tag: 'BREW', image: IMG.coldbrew, desc: 'Slow-steeped, smooth and easy-drinking.', chip: 'ASK IN STORE' }
];

const craftSteps = [
  { num: '01', label: 'Select', title: 'Ingredients worth choosing.', text: "We start with quality matcha, real dates and just the right coffee beans—because a diet café doesn't mean a flavor diet.", img: IMG.warm },
  { num: '02', label: 'Pour', title: 'Portions that make sense.', text: 'Every drink is measured and balanced. A little sweetness, a lot of flavor—without the sugar spike.', img: IMG.energy },
  { num: '03', label: 'Shake', title: 'Ice cold, always.', text: 'We shake and stir with intention. Cold brew slow-steeped for hours, matcha whisked until creamy.', img: IMG.summer },
  { num: '04', label: 'Serve', title: 'Presented with care.', text: 'Finally, we hand it to you in a cup worth slowing down for. Refresh, ready when you are.', img: IMG.quiet }
];

const galleryImages = [IMG.energy, IMG.guiltfree, IMG.warm, IMG.summer, IMG.quiet];

const quoteCards = [
  { quote: 'خلي الدايت أسهل ويا اختيارات ريفريش', attr: 'via @refresh.baghdad' },
  { quote: 'نفس النكهة اللي تحبوها بس بدون متزيدون السعرات', attr: 'via @refresh.baghdad' },
  { quote: 'كوب دافي، مزاج رايق، ووقت حلو من ريفريش', attr: 'via @refresh.baghdad' }
];
---

<Layout>
  <Hero />
  <main id="main">
    <!-- About -->
    <section id="about" class="relative bg-cream py-24 lg:py-32">
      <div class="mx-auto max-w-7xl px-4 lg:px-8">
        <div class="text-center">
          <p class="font-mono text-xs uppercase tracking-[0.35em] text-butter-dark">About us</p>
          <h2 class="reveal mx-auto mt-6 max-w-4xl font-display text-4xl uppercase leading-[0.95] md:text-6xl lg:text-7xl">
            The first diet café in Baghdad. Real taste, <span class="text-butter-dark">thoughtful ingredients.</span>
          </h2>
          <p class="reveal mx-auto mt-6 max-w-xl text-sm leading-relaxed text-anchor/70 md:text-base">
            At Refresh, we believe better-for-you can still be a treat. Every cup is made with intention — refreshing, satisfying and always delicious.
          </p>
          <a href="#visit" class="reveal mt-8 inline-flex items-center gap-2 rounded-full border-2 border-anchor bg-anchor px-7 py-3 font-mono text-xs font-bold uppercase tracking-widest text-cream shadow-hard transition hover:-translate-y-1 hover:bg-anchor-soft">
            Find the café
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
        <div class="relative mt-20 grid items-center gap-12 lg:grid-cols-2">
          <img src={IMG.quiet} alt="A quiet corner at Refresh Cafe" class="reveal mx-auto w-72 -rotate-6 rounded-[28px] border-4 border-anchor object-cover shadow-hard transition duration-500 hover:rotate-0 lg:w-96" loading="lazy" />
          <img src={IMG.warm} alt="A warm cup of coffee at Refresh Cafe" class="reveal mx-auto w-72 rotate-6 rounded-[28px] border-4 border-anchor object-cover shadow-hard-pink transition duration-500 hover:rotate-0 lg:w-96" style="transition-delay:120ms" loading="lazy" />
        </div>
      </div>
    </section>

    <!-- Signature Products -->
    <section id="menu" class="relative bg-anchor py-24 text-cream lg:py-36">
      <div class="mx-auto max-w-7xl px-4 lg:px-8">
        <div class="grid items-end gap-8 lg:grid-cols-12">
          <div class="lg:col-span-8">
            <p class="font-mono text-xs uppercase tracking-[0.35em] text-butter">Signature drinks</p>
            <h2 class="reveal mt-4 font-display text-5xl uppercase leading-[0.95] text-butter md:text-7xl">A little different.<br />Deliciously so.</h2>
          </div>
          <div class="lg:col-span-4">
            <p class="text-sm text-cream/70">Menu items rotate with the season and what's fresh. Ask in store for today's specials.</p>
            <Checker variant="lavender-butter" className="mt-6 justify-end" />
          </div>
        </div>
      </div>
      <div class="mt-16">
        <div id="product-viewport" class="overflow-hidden py-16">
          <div class="mx-auto max-w-7xl px-4 lg:px-8">
            <div id="product-track" class="flex gap-6 transition-transform duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)]">
              {products.map((p, i) => (
                <article
                  class={`product-card flex w-[260px] shrink-0 flex-col rounded-[24px] border-2 border-anchor p-6 shadow-hard transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] md:w-[280px] ${
                    i === 1 ? 'z-10 scale-105 bg-butter' : 'scale-95 bg-cream text-anchor opacity-75'
                  }`}
                  data-active={i === 1}
                >
                  <div class={`relative -mt-16 ${i === 1 ? 'z-10 scale-110 rotate-2' : ''}`}>
                    <img src={p.image} alt={p.name} class="aspect-square w-full rounded-2xl border-2 border-anchor object-cover shadow-soft" loading="lazy" />
                    <span class={`absolute -right-2 top-3 rounded-full border-2 border-anchor px-3 py-1 font-mono text-[10px] font-bold uppercase tracking-wider text-anchor ${i === 1 ? 'bg-pinkpop' : 'bg-lavenderpop'}`}>{p.chip}</span>
                  </div>
                  <p class="mt-5 font-mono text-[10px] uppercase tracking-[0.25em]">{p.tag}</p>
                  <h3 class="mt-1 font-display text-3xl uppercase">{p.name}</h3>
                  <p class="mt-2 text-sm text-anchor/70">{p.desc}</p>
                  <div class="mt-4 flex gap-2">
                    <span class="rounded-full border-2 border-anchor px-3 py-1 font-mono text-[10px] font-bold">S</span>
                    <span class="rounded-full border-2 border-anchor bg-butter px-3 py-1 font-mono text-[10px] font-bold">M</span>
                    <span class="rounded-full border-2 border-anchor px-3 py-1 font-mono text-[10px] font-bold">L</span>
                  </div>
                  <div class="mt-4">
                    <div class="flex justify-between font-mono text-[10px] uppercase"><span>Mild</span><span>Bold</span></div>
                    <div class="mt-1 h-2 rounded-full border border-anchor bg-cream"><div class="h-full w-2/3 rounded-full bg-butter-dark"></div></div>
                  </div>
                  <a
                    href={instagramUrl}
                    target="_blank"
                    rel="noreferrer"
                    class={`order-btn mt-6 inline-flex items-center justify-center gap-2 rounded-full border-2 border-anchor px-5 py-3 font-mono text-xs font-bold uppercase tracking-wider transition hover:-translate-y-0.5 ${
                      i === 1 ? 'bg-anchor text-cream' : 'bg-butter text-anchor'
                    }`}
                  >
                    Order via DM
                    <span class="grid h-6 w-6 place-items-center rounded-full border border-current">
                      <svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </span>
                  </a>
                </article>
              ))}
            </div>
          </div>
        </div>
        <div class="mt-2 flex justify-center gap-4">
          <button id="prev-product" class="grid h-12 w-12 place-items-center rounded-full border-2 border-butter bg-cream font-display text-2xl text-anchor shadow-hard transition hover:-translate-y-1" aria-label="Previous product">&larr;</button>
          <button id="next-product" class="grid h-12 w-12 place-items-center rounded-full border-2 border-butter bg-cream font-display text-2xl text-anchor shadow-hard transition hover:-translate-y-1" aria-label="Next product">&rarr;</button>
        </div>
      </div>
      <div class="mt-16 flex justify-center px-4">
        <Checker variant="dark-cream" className="gap-1 opacity-80" size="sm" />
      </div>
    </section>

    <!-- Café Experience -->
    <section id="experience" class="bg-cream py-24 lg:py-32">
      <div class="mx-auto max-w-7xl px-4 lg:px-8">
        <div class="grid gap-12 lg:grid-cols-12">
          <div class="lg:col-span-5">
            <p class="font-mono text-xs uppercase tracking-[0.35em] text-butter-dark">The café experience</p>
            <h2 class="reveal mt-4 font-display text-5xl uppercase leading-[0.95] md:text-6xl">Come for the cup.<br />Stay for the moment.</h2>
            <p class="reveal mt-6 text-sm leading-relaxed text-anchor/70 md:text-base">A cozy corner, warm light and drinks made with intention. Refresh was made for slow afternoons and good conversations.</p>
            <a href="#visit" class="reveal mt-8 inline-flex items-center gap-2 rounded-full border-2 border-anchor bg-butter px-7 py-3 font-mono text-xs font-bold uppercase tracking-widest text-anchor shadow-hard transition hover:-translate-y-1 hover:shadow-[6px_6px_0_0_#2A170D]">Plan your visit</a>
            <div class="mt-8 flex flex-wrap gap-3">
              <span class="rounded-full border-2 border-anchor bg-butter px-4 py-2 font-mono text-[10px] uppercase tracking-widest">Cozy corners</span>
              <span class="rounded-full border-2 border-anchor bg-lavenderpop px-4 py-2 font-mono text-[10px] uppercase tracking-widest">Freshly brewed</span>
              <span class="rounded-full border-2 border-anchor bg-pinkpop px-4 py-2 font-mono text-[10px] uppercase tracking-widest">Warm light</span>
            </div>
          </div>
          <div class="lg:col-span-7">
            <div class="relative">
              <img id="experience-main" src={IMG.energy} alt="Refresh Cafe drinks on the counter" class="aspect-[4/3] w-full rounded-[32px] border-4 border-anchor object-cover shadow-hard" loading="lazy" />
              <span id="experience-index" class="absolute bottom-4 left-4 rounded-full border-2 border-anchor bg-cream px-3 py-1 font-mono text-[10px] font-bold">01 / 05</span>
            </div>
            <div id="experience-thumbs" class="-mt-6 ml-6 flex gap-4 overflow-x-auto pb-6 pl-6">
              {galleryImages.map((src, i) => (
                <button
                  data-index={i}
                  data-src={src}
                  class={`experience-thumb h-16 w-16 shrink-0 overflow-hidden rounded-2xl border-4 bg-cream shadow-soft transition hover:-translate-y-1 md:h-20 md:w-20 ${
                    i === 0 ? 'border-butter-dark' : 'border-cream'
                  }`}
                  aria-label={`View gallery image ${i + 1}`}
                >
                  <img src={src} alt="" class="h-full w-full object-cover" loading="lazy" />
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- The Craft -->
    <section id="craft" class="bg-cream-warm py-24 lg:py-32">
      <div class="mx-auto max-w-7xl px-4 lg:px-8">
        <div class="grid items-end gap-10 lg:grid-cols-12">
          <div class="lg:col-span-7">
            <p class="font-mono text-xs uppercase tracking-[0.35em] text-butter-dark">The craft</p>
            <h2 class="reveal mt-4 font-display text-5xl uppercase leading-[0.95] md:text-7xl">Simple ingredients.<br />Careful hands.</h2>
          </div>
          <div class="lg:col-span-5">
            <p class="text-sm leading-relaxed text-anchor/70">From selecting the leaf to the last shake, every step is about balance. No shortcuts, no sugar shocks — just refresh.</p>
            <Checker variant="lavender-butter" className="mt-6 justify-end" />
          </div>
        </div>
        <div class="mt-16 rounded-[32px] border-2 border-anchor bg-anchor p-6 text-cream shadow-hard md:p-10">
          <div class="grid items-start gap-10 lg:grid-cols-2">
            <div>
              <div id="craft-num" class="grid h-12 w-12 place-items-center rounded-2xl bg-lavenderpop font-display text-2xl text-anchor">01</div>
              <p id="craft-label" class="mt-3 font-mono text-[10px] uppercase tracking-[0.25em] text-butter">Select</p>
              <h3 id="craft-title" class="mt-2 font-display text-4xl uppercase leading-none">Ingredients worth choosing.</h3>
              <p id="craft-text" class="mt-4 text-sm leading-relaxed text-cream/80">We start with quality matcha, real dates and just the right coffee beans — because a diet café doesn't mean a flavor diet.</p>
            </div>
            <div class="relative">
              <div class="absolute inset-0 translate-x-3 translate-y-3 rounded-2xl bg-pinkpop" aria-hidden="true"></div>
              <img id="craft-image" src={IMG.warm} alt="Ingredients worth choosing at Refresh Cafe" class="relative z-10 aspect-[4/3] w-full rounded-2xl border-4 border-cream object-cover" loading="lazy" />
            </div>
          </div>
          <div class="mt-10 grid grid-cols-2 divide-cream/20 border-t border-cream/20 md:grid-cols-4">
            {craftSteps.map((step, i) => (
              <button
                data-step={i}
                class={`craft-tab group flex flex-col items-start gap-2 border-r border-cream/20 px-4 py-5 text-left transition ${
                  i === 0 ? 'bg-cream/10' : ''
                }`}
                aria-pressed={i === 0}
              >
                <span class="font-mono text-[10px] tracking-widest text-cream/60">{step.num}</span>
                <span class="font-display text-xl uppercase text-butter transition group-hover:translate-x-1">{step.label}</span>
              </button>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Reviews -->
    <section id="reviews" class="relative bg-cream py-24 lg:py-32">
      <div class="pointer-events-none absolute left-0 right-0 top-0 flex justify-center opacity-30">
        <Checker variant="lavender-butter" size="sm" />
      </div>
      <div class="mx-auto max-w-7xl px-4 pt-10 lg:px-8">
        <div class="text-center">
          <p class="font-mono text-xs uppercase tracking-[0.35em] text-butter-dark">Community notes</p>
          <h2 class="reveal mt-4 font-display text-5xl uppercase leading-[0.95] md:text-7xl">A few words from our people.</h2>
        </div>
        <div class="relative mt-16 rounded-[32px] border-2 border-anchor bg-butter p-8 shadow-hard md:p-12">
          <span class="absolute right-6 top-2 font-display text-[140px] leading-none text-lavenderpop" aria-hidden="true">"</span>
          <div class="relative flex flex-col gap-6 md:flex-row md:items-center">
            <div class="grid h-20 w-20 shrink-0 place-items-center rounded-full border-4 border-anchor bg-lavenderpop font-display text-4xl text-anchor">R</div>
            <div>
              <div class="flex gap-1 text-star" aria-label="Rated 5 out of 5 stars">
                <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
              </div>
              <p id="feat-quote" class="mt-4 font-display text-2xl uppercase leading-tight md:text-4xl">"Refresh, without the guilt. ✨"</p>
              <p id="feat-attr" class="mt-4 font-mono text-[11px] uppercase tracking-widest text-anchor/70">@refresh.baghdad · Instagram</p>
            </div>
          </div>
        </div>
        <div class="mt-8 grid gap-6 md:grid-cols-3">
          {quoteCards.map((q, i) => (
            <Card
              className={`reveal review-card cursor-pointer rounded-[24px] border-2 border-anchor bg-butter-light p-6 shadow-hard transition hover:-translate-y-1 ${
                i === 0 ? 'ring-2 ring-butter-dark' : ''
              }`}
            >
              <div data-quote={q.quote} data-attr={q.attr}>
                <div class="flex items-center gap-3">
                  <div class="grid h-10 w-10 place-items-center rounded-full border-2 border-anchor bg-lavenderpop font-display text-lg text-anchor">R</div>
                  <p class="font-mono text-[11px] font-bold uppercase tracking-widest">{q.attr}</p>
                </div>
                <p class="mt-4 text-sm leading-relaxed text-anchor/75">"{q.quote}"</p>
                <div class="mt-4 flex gap-1 text-star" aria-label="5 star rating"><span>★</span><span>★</span><span>★</span><span>★</span><span>★</span></div>
              </div>
            </Card>
          ))}
        </div>
        <div class="mt-10 flex flex-col items-center gap-2">
          <p class="font-display text-4xl text-butter-dark">5.0★</p>
          <p class="font-mono text-[10px] uppercase tracking-widest text-anchor/60">Rated on Google · 5 reviews</p>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer ribbon -->
  <div class="relative z-10 -mb-6">
    <Marquee items={['Refresh', 'Good vibes', 'Zero guilt', 'Open now']} color="butter" reverse />
  </div>

  <!-- Visit / Footer -->
  <footer id="visit" class="relative overflow-hidden bg-anchor pb-10 pt-24 text-cream">
    <div class="absolute right-0 top-1/2 origin-bottom-right rotate-90 bg-lavenderpop px-4 py-2 font-mono text-[10px] font-bold uppercase tracking-widest text-anchor">Say hello</div>
    <div class="mx-auto max-w-7xl px-4 lg:px-8">
      <div class="grid items-center gap-14 lg:grid-cols-12">
        <div class="relative hidden h-[400px] lg:col-span-5 lg:block">
          <img src={IMG.matcha} alt="Iced matcha at Refresh Cafe" class="absolute left-1/2 top-1/2 w-80 -translate-x-1/2 -translate-y-1/2 -rotate-6 rounded-[45%_55%_60%_40%/55%_45%_60%_40%] border-4 border-cream object-cover shadow-soft" loading="lazy" />
          <span class="absolute bottom-10 left-8 rotate-6 rounded-full border-2 border-anchor bg-butter px-4 py-2 font-mono text-[10px] font-bold uppercase tracking-widest text-anchor shadow-[4px_4px_0_0_#F7A0B2]">Taste the refresh</span>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <div class="grid gap-6">
            <div class="rounded-[28px] border-2 border-anchor bg-cream p-8 text-anchor shadow-hard">
              <p class="font-mono text-[10px] uppercase tracking-[0.25em] text-butter-dark">Find us</p>
              <p class="mt-3 font-display text-2xl uppercase leading-tight md:text-3xl" dir="rtl">شارع هيل وزعفران مجاور دايت ستي، بغداد</p>
              <a href={mapLink} target="_blank" rel="noreferrer" class="mt-5 inline-flex items-center gap-2 rounded-full border-2 border-anchor bg-lavenderpop px-5 py-2.5 font-mono text-[10px] font-bold uppercase tracking-widest transition hover:-translate-y-0.5 hover:shadow-hard">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                Open maps
              </a>
            </div>
            <div class="rounded-[28px] border-2 border-anchor bg-butter p-8 text-anchor shadow-[8px_8px_0_0_#F7A0B2]">
              <p class="font-mono text-[10px] uppercase tracking-[0.25em]">See you there</p>
              <p class="mt-3 font-display text-4xl uppercase">Open now</p>
              <p class="mt-2 text-sm text-anchor/70">Call ahead for exact hours — we're always making something fresh.</p>
              <a href={phoneLink} class="mt-5 inline-flex items-center gap-2 rounded-full border-2 border-anchor bg-anchor px-5 py-2.5 font-mono text-[10px] font-bold uppercase tracking-widest text-cream transition hover:-translate-y-0.5 hover:bg-anchor-soft">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.6 2.81.72A2 2 0 0 1 22 16.92Z"/></svg>
                {phoneDisplay}
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-16 grid gap-8 border-t border-cream/20 pt-8 md:grid-cols-4 md:items-start">
        <div class="flex items-center gap-3 md:col-span-2">
          <img src={profilePic} alt="Refresh Cafe logo" class="h-12 w-12 rounded-full border-2 border-butter object-cover" loading="lazy" />
          <div>
            <p class="font-display text-2xl uppercase">Refresh Cafe</p>
            <p class="font-mono text-[10px] uppercase tracking-widest text-cream/60">Baghdad's first diet café</p>
          </div>
        </div>
        <div>
          <p class="font-mono text-[10px] uppercase tracking-widest text-cream/50">Quick links</p>
          <div class="mt-3 flex flex-col gap-2">
            <a href="#about" class="text-sm text-cream/70 transition hover:text-butter">About</a>
            <a href="#menu" class="text-sm text-cream/70 transition hover:text-butter">Menu</a>
            <a href="#craft" class="text-sm text-cream/70 transition hover:text-butter">Craft</a>
            <a href="#visit" class="text-sm text-cream/70 transition hover:text-butter">Visit</a>
          </div>
        </div>
        <div>
          <p class="font-mono text-[10px] uppercase tracking-widest text-cream/50">Visit</p>
          <div class="mt-3 flex flex-col gap-2 text-sm text-cream/70">
            <a href={mapLink} target="_blank" rel="noreferrer" class="transition hover:text-butter">شارع هيل وزعفران، بغداد</a>
            <a href={phoneLink} class="transition hover:text-butter">{phoneDisplay}</a>
            <a href={instagramUrl} target="_blank" rel="noreferrer" class="transition hover:text-butter">@refresh.baghdad</a>
          </div>
        </div>
      </div>

      <div class="mt-12 flex flex-col items-center justify-between gap-4 md:flex-row">
        <p class="font-mono text-[10px] uppercase tracking-widest text-cream/40">© {new Date().getFullYear()} Refresh Cafe. Made with love in Baghdad.</p>
        <div class="flex gap-3">
          <a href={instagramUrl} target="_blank" rel="noreferrer" class="grid h-10 w-10 place-items-center rounded-full border-2 border-cream/20 bg-cream/10 text-cream transition hover:-translate-y-1 hover:bg-butter hover:text-anchor" aria-label="Refresh Cafe on Instagram">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
          <a href={phoneLink} class="grid h-10 w-10 place-items-center rounded-full border-2 border-cream/20 bg-cream/10 text-cream transition hover:-translate-y-1 hover:bg-butter hover:text-anchor" aria-label="Call Refresh Cafe">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.6 2.81.72A2 2 0 0 1 22 16.92Z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </footer>
</Layout>

<script>
  // Product carousel
  const track = document.getElementById('product-track');
  const viewport = document.getElementById('product-viewport');
  const cards = track ? Array.from(track.children) : [];
  let currentIndex = 1;
  const cardCount = cards.length;

  function updateProductCarousel() {
    if (!track || !viewport || cardCount === 0) return;
    const cardWidth = cards[0].offsetWidth + 24;
    const target = viewport.offsetWidth / 2 - cards[0].offsetWidth / 2 - currentIndex * cardWidth;
    track.style.transform = `translateX(${target}px)`;

    cards.forEach((card, i) => {
      const active = i === currentIndex;
      card.dataset.active = String(active);
      const btn = card.querySelector('.order-btn');
      if (active) {
        card.classList.remove('bg-cream', 'opacity-75', 'scale-95');
        card.classList.add('bg-butter', 'z-10', 'scale-105');
        btn?.classList.add('bg-anchor', 'text-cream');
        btn?.classList.remove('bg-butter', 'text-anchor');
      } else {
        card.classList.remove('bg-butter', 'z-10', 'scale-105');
        card.classList.add('bg-cream', 'opacity-75', 'scale-95');
        btn?.classList.add('bg-butter', 'text-anchor');
        btn?.classList.remove('bg-anchor', 'text-cream');
      }
    });
  }

  updateProductCarousel();
  window.addEventListener('resize', updateProductCarousel);

  document.getElementById('prev-product')?.addEventListener('click', () => {
    currentIndex = (currentIndex - 1 + cardCount) % cardCount;
    updateProductCarousel();
  });
  document.getElementById('next-product')?.addEventListener('click', () => {
    currentIndex = (currentIndex + 1) % cardCount;
    updateProductCarousel();
  });

  // Experience gallery
  const mainImg = document.getElementById('experience-main');
  const expIndex = document.getElementById('experience-index');
  const thumbs = document.querySelectorAll('.experience-thumb');
  thumbs.forEach((thumb) => {
    thumb.addEventListener('click', () => {
      const i = Number(thumb.dataset.index);
      mainImg.src = thumb.dataset.src;
      mainImg.alt = `Refresh Cafe gallery image ${i + 1}`;
      expIndex.textContent = `0${i + 1} / 05`;
      thumbs.forEach((t) => t.classList.remove('border-butter-dark'));
      thumb.classList.add('border-butter-dark');
      mainImg.style.transition = 'opacity 0.4s ease';
      mainImg.style.opacity = '0';
      setTimeout(() => {
        mainImg.style.opacity = '1';
      }, 400);
    });
  });

  // Craft tabs
  const craftData = [
    { num: '01', label: 'Select', title: 'Ingredients worth choosing.', text: "We start with quality matcha, real dates and just the right coffee beans—because a diet café doesn't mean a flavor diet.", img: `${IMG.warm}` },
    { num: '02', label: 'Pour', title: 'Portions that make sense.', text: 'Every drink is measured and balanced. A little sweetness, a lot of flavor—without the sugar spike.', img: `${IMG.energy}` },
    { num: '03', label: 'Shake', title: 'Ice cold, always.', text: 'We shake and stir with intention. Cold brew slow-steeped for hours, matcha whisked until creamy.', img: `${IMG.summer}` },
    { num: '04', label: 'Serve', title: 'Presented with care.', text: 'Finally, we hand it to you in a cup worth slowing down for. Refresh, ready when you are.', img: `${IMG.quiet}` }
  ];
  const craftTabs = document.querySelectorAll('.craft-tab');
  function updateStep(i) {
    const step = craftData[i];
    document.getElementById('craft-num').textContent = step.num;
    document.getElementById('craft-label').textContent = step.label;
    document.getElementById('craft-title').textContent = step.title;
    document.getElementById('craft-text').textContent = step.text;
    document.getElementById('craft-image').src = step.img;
    document.getElementById('craft-image').alt = step.title;
    craftTabs.forEach((tab, index) => {
      const isActive = index === i;
      tab.classList.toggle('bg-cream/10', isActive);
      tab.setAttribute('aria-pressed', String(isActive));
    });
  }
  craftTabs.forEach((tab) => {
    tab.addEventListener('click', () => updateStep(Number(tab.dataset.step)));
  });

  // Featured review promos
  const reviewCards = document.querySelectorAll('.review-card');
  const featQuote = document.getElementById('feat-quote');
  const featAttr = document.getElementById('feat-attr');
  reviewCards.forEach((card) => {
    card.addEventListener('click', () => {
      const quote = card.querySelector('[data-quote]');
      if (!quote) return;
      featQuote.textContent = `"${quote.dataset.quote}"`;
      featAttr.textContent = quote.dataset.attr;
      reviewCards.forEach((c) => c.classList.remove('ring-2', 'ring-butter-dark'));
      card.classList.add('ring-2', 'ring-butter-dark');
    });
  });
</script>