---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import MarqueeRibbon from '../components/MarqueeRibbon.astro';
import CheckerCluster from '../components/CheckerCluster.astro';

// Real Data from Instagram & Google Places
const googleData = {
  name: "Refresh Cafe",
  rating: 5.0,
  user_ratings_total: 5,
  formatted_address: "Al-Mansour, Al-Dawoodi, Hayl & Zaafaran St, Next to Diet City, Baghdad",
  formatted_phone_number: "+964 773 999 9038",
  open_now: true,
};

const instaData = {
  username: "refresh.baghdad",
  followers: "3.5K+",
  bio: "أول كافيه دايت في بغداد يقدّم توازن حقيقي بين اللذة والصحة 🤎",
};

// Curated supplied real imagery
const heroDrinkImg = "https://scontent-ams2-1.cdninstagram.com/v/t51.82787-15/794032623_17948492067266823_7578226426693012433_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=107&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0xJUFMuYmVzdF9pbWFnZV91cmxnZW4uQzMifQ%3D%3D&_nc_ohc=NYjctEAvy7cQ7kNvwFHmiSP&_nc_oc=Adph5_RVWf2icuScJwmhAxHO8P_RB8oZUWFhxo62FNyTEbrzne6WhCP-EQgxmMBZNo4&_nc_zt=23&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=cO0pZhQ1iJyLHDhTQ7H9Fw&_nc_ss=7ba8c&oh=00_AQNZ0AR79KsE0exUGsrTSfuBfJpq0kzO5sgxGTwTZIa6AA&oe=6AC1E3F9";
const latteImg = "https://scontent-ams2-1.cdninstagram.com/v/t51.82787-15/776718665_17946476757266823_3092288458190742280_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=101&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0xJUFMuYmVzdF9pbWFnZV91cmxnZW4uQzMifQ%3D%3D&_nc_ohc=Z3Cwie8nHwkQ7kNvwEwnhC4&_nc_oc=AdrQtodvlccHUvaeHo7b2bHkP3djMDX5TGMqNPIEaS9OoQkSxtvSUUBXLkte7oWjd2U&_nc_zt=23&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=cO0pZhQ1iJyLHDhTQ7H9Fw&_nc_ss=7ba8c&oh=00_AQPZHPFo9YZI5fw4pcYvmq97sLXDnxDJuow6lCPZGeA_5w&oe=6AC1E3AE";
const dateShakeImg = "https://scontent-ams2-1.cdninstagram.com/v/t51.82787-15/779145745_17946355131266823_6141674129459981372_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=105&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0FST1VTRUxfSVRFTS5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=ZCuU1PJApxgQ7kNvwER0Rna&_nc_oc=AdrMjokD5-9uOyDrezyV0GHSK0I8cT2KHL-hJPKOoiu3Raqa6aSXuijd5D9o71n3MsM&_nc_zt=23&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=cO0pZhQ1iJyLHDhTQ7H9Fw&_nc_ss=7ba8c&oh=00_AQOEJxRfbfvpkJTM8TPNKFYqjff2Qld_qrU6S8fEcTIBzw&oe=6AC1F0DE";
const coldBrewImg = "https://scontent-ams2-1.cdninstagram.com/v/t15.5256-10/780949353_1596279635189869_1153598757660377946_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=104&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0xJUFMuYmVzdF9pbWFnZV91cmxnZW4uQzMifQ%3D%3D&_nc_ohc=siUSfyJphccQ7kNvwGXGNh3&_nc_oc=Adp5ClswIvrBuk9UMFF2r4wynoSF4eYDZSTdD_YMF--XlB9UJktW_sGhTUrsOYx9e-4&_nc_zt=23&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=cO0pZhQ1iJyLHDhTQ7H9Fw&_nc_ss=7ba8c&oh=00_AQMAFgIL7451-Jw8cT4NeJMKx_lYUvv1mzkKJx0-ZQRwJQ&oe=6AC1E8E3";
const warmVibeImg = "https://scontent-ams2-1.cdninstagram.com/v/t51.82787-15/769528731_17944263906266823_5881257777323666093_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=107&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0xJUFMuYmVzdF9pbWFnZV91cmxnZW4uQzMifQ%3D%3D&_nc_ohc=vVSHWsKezj0Q7kNvwE_1F6T&_nc_oc=Adok7oQj-l3Gd_lR_qiVyXSWxPASNVHNYPpo-GjqNhQIcMl9Q99fI4i49V1ljliV6AQ&_nc_zt=23&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=cO0pZhQ1iJyLHDhTQ7H9Fw&_nc_ss=7ba8c&oh=00_AQOeJDlml8W9lO8tUrbaursvvnHcMa0Y2SevcE1T8VRSEA&oe=6AC20722";
const dessertImg = "https://scontent-ams2-1.cdninstagram.com/v/t39.30808-6/767002513_122200920686767471_8275407980521003658_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=101&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiRkVFRC5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=t5w9PZbMXw8Q7kNvwFkqShs&_nc_oc=AdokUgTqNqOfWBbstQA1iw_zORgRBJ36AUuRVjlHhmzTwJZXbpoDadb2MvSpxfJoQ5w&_nc_zt=23&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=cO0pZhQ1iJyLHDhTQ7H9Fw&_nc_ss=7ba8c&oh=00_AQNJbZGpSvaU6U3I2Rul9p9sSj8VgYuQb4OqJTW6diWT6A&oe=6AC20D4F";
const summerImg = "https://scontent-ams2-1.cdninstagram.com/v/t51.82787-15/768926201_17943806736266823_197649942369072822_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=101&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiRkVFRC5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=ojwx0PIcx6cQ7kNvwHakwM5&_nc_oc=AdrohkdxSnOG6lhDI_JLSki2F1vfuGJyFUd_91C5MdYPxCNTuNWuZSYHqFbVIOesk9o&_nc_zt=23&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=cO0pZhQ1iJyLHDhTQ7H9Fw&_nc_ss=7ba8c&oh=00_AQMVVpIOnQJ0DE6BAofxM9ijXZvU7PjybVQS_hIDR7eWvQ&oe=6AC1F8E0";
const sereneImg = "https://scontent-ams2-1.cdninstagram.com/v/t51.82787-15/765175304_17943473940266823_6613519965218726446_n.jpg?stp=dst-jpg_e35_s640x640_tt6&_nc_cat=109&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiRkVFRC5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=zSryh1NaIckQ7kNvwG3zLik&_nc_oc=AdrpU3kvQbihxR-w3b4-hCgu7PSCvhRJTZgkZeOedF8g24BxUt28SAiTvYe38Ker59M&_nc_zt=23&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=cO0pZhQ1iJyLHDhTQ7H9Fw&_nc_ss=7ba8c&oh=00_AQPucM398AbbJ78lpFmU8ao3dJSwi002mEO_9IbhV1y5QQ&oe=6AC1EAF1";
---

<Layout>
  <Navbar />

  <!-- 1. HERO SECTION (Butter Background) -->
  <section class="relative bg-butter pt-28 sm:pt-36 pb-20 sm:pb-28 overflow-hidden border-b-2 border-anchor">
    <!-- Top-Right Checkerboard cluster -->
    <div class="absolute top-6 right-6 sm:top-12 sm:right-12 hidden sm:block">
      <CheckerCluster theme="butter-lav" rows={4} cols={5} />
    </div>

    <!-- Organic Blob Highlight in Background -->
    <div class="absolute top-1/2 right-1/4 -translate-y-1/2 w-[340px] sm:w-[500px] h-[340px] sm:h-[500px] bg-cream/60 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 sm:gap-12 items-center">
        
        <!-- Left: Huge Typography & CTA -->
        <div class="lg:col-span-7 flex flex-col items-start">
          <!-- Mono Eyebrow Tag -->
          <div class="inline-flex items-center gap-2 bg-anchor text-butter font-mono text-[11px] sm:text-xs font-bold uppercase tracking-widest px-3.5 py-1.5 rounded-full mb-6 shadow-[2px_2px_0px_#FFAAC9]">
            <span class="w-2 h-2 rounded-full bg-popPink"></span>
            BAGHDAD'S #1 DIET CAFE
          </div>

          <!-- Dramatic Display Headline -->
          <h1 class="text-anchor text-5xl sm:text-7xl lg:text-[5.5rem] tracking-tight mb-6 font-display">
            PURE FLAVOR. <br/>
            <span class="text-anchor underline decoration-popPink decoration-wavy decoration-4">ZERO GUILT.</span>
          </h1>

          <!-- Body Description -->
          <p class="text-anchor/85 text-base sm:text-lg max-w-xl font-medium leading-relaxed mb-8">
            أول كافيه دايت في بغداد يقدّم توازن حقيقي بين اللذة والصحة. Specialty coffee, sugar-free cold brews, ceremonial matcha, and calculated macros crafted for your daily energy.
          </p>

          <!-- CTAs -->
          <div class="flex flex-wrap items-center gap-4 w-full sm:w-auto">
            <a 
              href="#menu" 
              class="w-full sm:w-auto bg-anchor hover:bg-anchor-light text-butter font-mono text-xs sm:text-sm font-extrabold uppercase px-7 py-4 rounded-full border-2 border-anchor shadow-offset-pink hover:translate-y-[-2px] active:translate-y-[2px] transition-all flex items-center justify-between sm:justify-center gap-4 group"
            >
              <span>EXPLORE DIET MENU</span>
              <span class="w-7 h-7 rounded-full bg-butter text-anchor flex items-center justify-center font-bold group-hover:rotate-45 transition-transform">
                →
              </span>
            </a>

            <a 
              href="https://maps.google.com/?q=Refresh+Cafe+Al-Mansour+Baghdad" 
              target="_blank" 
              rel="noopener noreferrer"
              class="w-full sm:w-auto text-anchor hover:text-popPink font-mono text-xs sm:text-sm font-bold uppercase px-4 py-3 flex items-center justify-center gap-2 transition-colors underline decoration-2 underline-offset-4"
            >
              <span>FIND OUR LOCATION</span>
              <span>↗</span>
            </a>
          </div>

          <!-- Google Place & Social Proof Badge -->
          <div class="mt-10 sm:mt-12 flex flex-wrap items-center gap-6 pt-6 border-t border-anchor/20 w-full">
            <div class="flex items-center gap-3 bg-cream px-4 py-2 rounded-full border-2 border-anchor shadow-[3px_3px_0px_#27170E]">
              <div class="flex text-starGold text-sm">★★★★★</div>
              <span class="font-mono text-xs font-bold text-anchor">{googleData.rating}.0 ({googleData.user_ratings_total} Reviews)</span>
            </div>
            
            <div class="flex items-center gap-2 text-xs font-mono font-bold text-anchor/80">
              <span class="w-2.5 h-2.5 rounded-full bg-popPink inline-block"></span>
              <span>{instaData.followers} Instagram Community</span>
            </div>
          </div>
        </div>

        <!-- Right: Signature Hero Product & Floating Accents -->
        <div class="lg:col-span-5 relative flex justify-center">
          <!-- Main Cutout-Styled Photo Frame with Hard Pink Shadow -->
          <div class="relative w-full max-w-[360px] sm:max-w-[420px]">
            <div class="relative bg-cream p-3 sm:p-4 rounded-[32px] border-3 border-anchor shadow-offset-pink-lg rotate-1 hover:rotate-0 transition-transform duration-500">
              <div class="aspect-square rounded-[24px] overflow-hidden border-2 border-anchor bg-popLav relative">
                <img 
                  src={heroDrinkImg} 
                  alt="Signature Iced Matcha - Refresh Cafe" 
                  class="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
                  loading="eager"
                />
                <!-- Price / Calorie Chip -->
                <div class="absolute top-3 left-3 bg-butter border-2 border-anchor px-3 py-1 rounded-full font-mono text-[11px] font-extrabold uppercase shadow-[2px_2px_0px_#27170E]">
                  CEREMONIAL GRADE MATCHA 🍵
                </div>
              </div>

              <div class="pt-3 pb-1 px-2 flex items-center justify-between">
                <div>
                  <p class="font-display text-xl text-anchor">ICED MATCHA REFRESH</p>
                  <p class="font-mono text-[10px] text-anchor/70 font-bold uppercase tracking-wider">Smooth • Creamy • Low Cal</p>
                </div>
                <div class="w-8 h-8 rounded-full bg-popPink border border-anchor flex items-center justify-center font-bold text-xs">
                  ✨
                </div>
              </div>
            </div>

            <!-- Floating Prop 1 (Cold Brew Mini Badge) -->
            <div class="absolute -bottom-6 -left-6 bg-popLav border-2 border-anchor p-2.5 sm:p-3 rounded-2xl shadow-offset-dark -rotate-6 animate-float-slow hidden sm:flex items-center gap-2.5">
              <div class="w-10 h-10 rounded-xl overflow-hidden border border-anchor bg-cream">
                <img src={coldBrewImg} alt="Cold Brew" class="w-full h-full object-cover" />
              </div>
              <div class="font-mono text-[10px] leading-tight">
                <span class="block font-black text-anchor">COLD BREW 🧊</span>
                <span class="text-anchor/70 font-bold">Slow Extracted</span>
              </div>
            </div>

            <!-- Floating Prop 2 (Sticker) -->
            <div class="absolute -top-5 -right-4 bg-butter border-2 border-anchor py-1.5 px-3 rounded-full font-mono text-[10px] font-extrabold shadow-[2px_2px_0px_#27170E] rotate-12">
              100% HEALTHY VIBES
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 2. MARQUEE RIBBON 1 (Bubblegum Pink) -->
  <MarqueeRibbon 
    words={["ICED MATCHA", "COLD BREW", "DIET LATTE", "DATE SHAKE", "SUGAR FREE", "HIGH PROTEIN", "BAGHDAD AL-MANSOUR"]} 
    bgColor="bg-popPink"
    tiltClass="-rotate-1"
    direction="left"
  />

  <!-- 3. ABOUT SECTION (Base Light + Tilted Floating Frames) -->
  <section id="about" class="py-24 sm:py-36 bg-cream relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 relative">
      
      <!-- Eyebrow & Headline -->
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="font-mono text-xs uppercase font-extrabold tracking-widest text-popPink bg-anchor px-3 py-1 rounded-full mb-4 inline-block">
          ABOUT REFRESH CAFE
        </span>
        <h2 class="text-4xl sm:text-6xl text-anchor font-display tracking-tight mb-6 mt-3">
          HEALTHY CHOICES. <br class="hidden sm:inline"/>
          UNCOMPROMISED TASTE.
        </h2>
        <p class="font-display text-xl sm:text-2xl text-anchor/90 uppercase tracking-tight leading-snug">
          "أول كافيه دايت في بغداد يقدّم توازن حقيقي بين اللذة والصحة 🤎. WE CRAFT EVERY SIP WITH CALCULATED CALORIES AND PURE PASSION."
        </p>
      </div>

      <!-- Center Visual & Tilted Polaroid Frames -->
      <div class="relative grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 items-center my-12">
        
        <!-- Left Tilted Photo Frame -->
        <div class="transform md:-rotate-6 hover:rotate-0 transition-all duration-300">
          <div class="bg-cream-tint p-4 rounded-3xl border-3 border-anchor shadow-offset-dark">
            <div class="aspect-[4/3] rounded-2xl overflow-hidden border-2 border-anchor bg-butter">
              <img src={latteImg} alt="Diet Latte by Refresh" class="w-full h-full object-cover" />
            </div>
            <p class="font-mono text-xs font-bold text-center mt-3 uppercase text-anchor">
              ☕ DIET LATTE • NO EXTRA CALORIES
            </p>
          </div>
        </div>

        <!-- Center Feature Box -->
        <div class="bg-butter rounded-3xl p-6 sm:p-8 border-3 border-anchor shadow-offset-pink text-center flex flex-col justify-center items-center">
          <div class="w-14 h-14 rounded-2xl bg-anchor text-butter flex items-center justify-center font-display text-3xl mb-4 border-2 border-anchor">
            0%
          </div>
          <h3 class="font-display text-2xl text-anchor mb-2">REFINED SUGAR</h3>
          <p class="text-xs sm:text-sm font-sans font-medium text-anchor/80 mb-6">
            We curate alternatives that fuel your lifestyle without sacrificing rich indulgence.
          </p>
          <a href="#menu" class="bg-anchor text-cream font-mono text-[11px] font-bold uppercase px-5 py-2.5 rounded-full border border-anchor hover:bg-anchor-light transition-colors">
            VIEW DRINK SELECTION
          </a>
        </div>

        <!-- Right Tilted Photo Frame -->
        <div class="transform md:rotate-6 hover:rotate-0 transition-all duration-300">
          <div class="bg-cream-tint p-4 rounded-3xl border-3 border-anchor shadow-offset-lav">
            <div class="aspect-[4/3] rounded-2xl overflow-hidden border-2 border-anchor bg-popLav">
              <img src={warmVibeImg} alt="Cozy Refresh Moment" class="w-full h-full object-cover" />
            </div>
            <p class="font-mono text-xs font-bold text-center mt-3 uppercase text-anchor">
              ✨ كُوب دافي ومزاج رايق
            </p>
          </div>
        </div>

      </div>

      <!-- Feature Pill Badges -->
      <div class="flex flex-wrap justify-center items-center gap-3 sm:gap-4 mt-8">
        <span class="bg-cream border-2 border-anchor px-4 py-2 rounded-full font-mono text-xs font-bold uppercase shadow-[2px_2px_0px_#27170E]">
          📍 Al-Mansour, Baghdad
        </span>
        <span class="bg-popLav border-2 border-anchor px-4 py-2 rounded-full font-mono text-xs font-bold uppercase shadow-[2px_2px_0px_#27170E]">
          🌱 100% Calculated Macros
        </span>
        <span class="bg-butter border-2 border-anchor px-4 py-2 rounded-full font-mono text-xs font-bold uppercase shadow-[2px_2px_0px_#27170E]">
          🧊 Specialty Cold Extraction
        </span>
      </div>

    </div>
  </section>

  <!-- 4. SIGNATURE PRODUCTS (Anchor Dark Dramatic Band) -->
  <section id="menu" class="bg-anchor text-cream py-24 sm:py-32 relative overflow-hidden">
    <!-- Checker Cluster top right -->
    <div class="absolute top-8 right-8 hidden md:block">
      <CheckerCluster theme="butter-lav" rows={3} cols={4} />
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
        <div>
          <span class="font-mono text-xs font-extrabold uppercase tracking-widest text-anchor bg-butter px-3 py-1 rounded-full inline-block mb-3">
            SIGNATURE DRINKS & BITES
          </span>
          <h2 class="text-4xl sm:text-6xl text-butter font-display tracking-tight">
            A LITTLE DIFFERENT. <br/>
            DELICIOUSLY SO.
          </h2>
        </div>
        <p class="text-cream/80 max-w-md font-sans text-sm sm:text-base leading-relaxed">
          Explore our most-loved creations crafted to give you the exact taste you crave with zero refined sugars and clean ingredients.
        </p>
      </div>

      <!-- Carousel Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8 items-stretch">
        
        <!-- Product 1: Iced Matcha (Featured Card) -->
        <div class="bg-butter text-anchor rounded-3xl p-5 border-3 border-anchor shadow-offset-pink flex flex-col justify-between transform lg:-translate-y-4 hover:translate-y-[-8px] transition-transform duration-300">
          <div>
            <div class="flex justify-between items-start mb-3">
              <span class="bg-popPink text-anchor border border-anchor px-2.5 py-1 rounded-full font-mono text-[10px] font-black uppercase">
                BESTSELLER 🍵
              </span>
              <span class="font-mono text-xs font-bold">CALCULATED KCAL</span>
            </div>
            
            <div class="aspect-square rounded-2xl overflow-hidden border-2 border-anchor mb-4 bg-cream shadow-sm">
              <img src={heroDrinkImg} alt="Iced Matcha" class="w-full h-full object-cover" />
            </div>

            <h3 class="font-display text-2xl text-anchor mb-1">ICED MATCHA</h3>
            <p class="font-mono text-[11px] text-anchor/80 font-semibold uppercase mb-4">Ceremonial Matcha • Oat Milk • Sugar Free</p>
          </div>

          <div class="pt-4 border-t border-anchor/20">
            <div class="flex items-center justify-between font-mono text-xs font-bold mb-3">
              <span>INTENSITY</span>
              <span class="text-[10px] bg-anchor text-butter px-2 py-0.5 rounded">SMOOTH & BOLD</span>
            </div>
            <a href="tel:+9647739999038" class="w-full bg-anchor hover:bg-anchor-light text-butter font-mono text-xs font-extrabold uppercase py-3 rounded-xl border border-anchor flex items-center justify-center gap-2 transition-colors">
              <span>ORDER IN STORE</span>
              <span>→</span>
            </a>
          </div>
        </div>

        <!-- Product 2: Diet Latte -->
        <div class="bg-cream text-anchor rounded-3xl p-5 border-3 border-anchor shadow-offset-lav flex flex-col justify-between hover:translate-y-[-4px] transition-transform duration-300">
          <div>
            <div class="flex justify-between items-start mb-3">
              <span class="bg-popLav text-anchor border border-anchor px-2.5 py-1 rounded-full font-mono text-[10px] font-black uppercase">
                COFFEE SPECIAL ☕
              </span>
              <span class="font-mono text-xs font-bold">HOT / ICED</span>
            </div>
            
            <div class="aspect-square rounded-2xl overflow-hidden border-2 border-anchor mb-4 bg-butter shadow-sm">
              <img src={latteImg} alt="Diet Latte" class="w-full h-full object-cover" />
            </div>

            <h3 class="font-display text-2xl text-anchor mb-1">DIET LATTE</h3>
            <p class="font-mono text-[11px] text-anchor/80 font-semibold uppercase mb-4">Double Espresso • Steamed Skim/Almond Milk</p>
          </div>

          <div class="pt-4 border-t border-anchor/10">
